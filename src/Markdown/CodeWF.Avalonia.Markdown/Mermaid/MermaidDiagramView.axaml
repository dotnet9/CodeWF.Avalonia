<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CodeWF.Avalonia.Markdown.Mermaid"
             x:Class="CodeWF.Avalonia.Markdown.Mermaid.MermaidDiagramView"
             x:DataType="local:MermaidDiagramViewModel">
  <StackPanel Spacing="8">
    <Border Classes="diagram-source" IsVisible="{Binding IsEditing}" CornerRadius="8"
            BorderThickness="1" Padding="3">
      <TextBox Name="SourceInput" Text="{Binding Source, Mode=TwoWay}" AcceptsReturn="True"
               FontFamily="Consolas,Menlo,monospace" FontSize="13" MinHeight="128" MaxHeight="360"
               TextWrapping="NoWrap" Padding="10,8" BorderThickness="0" Background="Transparent"
               VerticalContentAlignment="Top"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Border>
    <Panel>
      <Button Name="PreviewButton" Padding="0" BorderThickness="0" Background="Transparent"
              MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch" Cursor="Hand" AutomationProperties.Name="mermaid">
        <ContentControl Name="PreviewContent" HorizontalContentAlignment="Stretch"/>
      </Button>
      <Button Name="SourceBadge" Content="mermaid" FontFamily="Consolas,Menlo,monospace" FontSize="12"
              Padding="12,3" MinHeight="0" BorderThickness="1" CornerRadius="6"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"/>
    </Panel>
  </StackPanel>
</UserControl>
