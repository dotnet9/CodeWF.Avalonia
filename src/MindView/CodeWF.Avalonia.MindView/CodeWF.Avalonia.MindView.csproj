<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Avalonia mind map editor, Markdown viewer, import/export and light/dark accent themes in one package.</Description>
    <PackageTags>avalonia;mindmap;markdown;themes;codewf</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <ProjectReference Include="../../Lang/CodeWF.Avalonia.Lang/CodeWF.Avalonia.Lang.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="I18n/*.json" />
    <EmbeddedResource Include="I18n/*.json" />
    <AvaloniaResource Include="Assets/Cursors/*.png" />
  </ItemGroup>
</Project>
