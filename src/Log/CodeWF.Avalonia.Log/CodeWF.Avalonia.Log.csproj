<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>面向 Avalonia 的日志查看控件与桌面通知：基于轻量日志核心展示实时日志、级别过滤与界面友好内容，适合桌面应用内嵌日志观察台。Avalonia log viewer control with desktop notifications on top of the lightweight logging core.</Description>
    <PackageTags>avalonia;log;viewer;codewf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Xaml.Behaviors" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="CodeWF.Toolkit.Logging" />
  </ItemGroup>

</Project>
