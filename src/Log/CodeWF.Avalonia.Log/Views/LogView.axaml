<UserControl
    x:Class="CodeWF.Avalonia.Log.LogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    MinWidth="0"
    ContentForeground="{DynamicResource CodeWFLogViewContentForeground}"
    ErrorForeground="{DynamicResource CodeWFLogViewErrorForeground}"
    InformationForeground="{DynamicResource CodeWFLogViewInformationForeground}"
    TimestampForeground="{DynamicResource CodeWFLogViewTimestampForeground}"
    TraceForeground="{DynamicResource CodeWFLogViewTraceForeground}"
    WarningForeground="{DynamicResource CodeWFLogViewWarningForeground}"
    mc:Ignorable="d">
    <ScrollViewer
        x:Name="LogScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        PointerPressed="LogScrollViewer_OnPointerPressed"
        VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock
            x:Name="LogTextView"
            HorizontalAlignment="Stretch"
            MinWidth="0"
            TextAlignment="Start"
            TextWrapping="Wrap">
            <SelectableTextBlock.ContextMenu>
                <ContextMenu x:Name="LogContextMenu">
                    <MenuItem x:Name="CopyMenuItem" Click="Copy_OnClick" />
                    <MenuItem x:Name="ClearMenuItem" Click="Clear_OnClick" />
                    <MenuItem x:Name="LocationMenuItem" Click="Location_OnClick" />
                </ContextMenu>
            </SelectableTextBlock.ContextMenu>
        </SelectableTextBlock>
    </ScrollViewer>
</UserControl>
