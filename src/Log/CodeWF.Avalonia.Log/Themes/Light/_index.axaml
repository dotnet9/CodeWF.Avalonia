<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="CodeWFLogViewTimestampForeground">#667085</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewContentForeground">#262626</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewTraceForeground">#0969DA</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewInformationForeground">#237B25</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewWarningForeground">#9A6700</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewErrorForeground">#CF222E</SolidColorBrush>
</ResourceDictionary>
