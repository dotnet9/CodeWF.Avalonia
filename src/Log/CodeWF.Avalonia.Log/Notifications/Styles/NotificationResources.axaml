<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="CodeWF.Avalonia.Log.Notifications.Styles.NotificationResources">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="Default" Source="Light.axaml" />
        <ResourceInclude x:Key="Light" Source="Light.axaml" />
        <ResourceInclude x:Key="Dark" Source="Dark.axaml" />
    </ResourceDictionary.ThemeDictionaries>

    <!-- 可见卡片为 360px；窗口四周各保留 8px 透明区域承载阴影。 -->
    <x:Double x:Key="CodeWFLogDesktopNotificationWindowWidth">376</x:Double>
    <x:Double x:Key="CodeWFLogDesktopNotificationWindowMinHeight">300</x:Double>
    <x:Double x:Key="CodeWFLogDesktopNotificationWindowMaxHeight">436</x:Double>
    <Thickness x:Key="CodeWFLogDesktopNotificationWindowMargin">8</Thickness>
    <Thickness x:Key="CodeWFLogDesktopNotificationWindowBorderThickness">1</Thickness>
    <CornerRadius x:Key="CodeWFLogDesktopNotificationWindowCornerRadius">8</CornerRadius>
    <BoxShadows x:Key="CodeWFLogDesktopNotificationWindowBoxShadow">0 4 40 0 #40000000</BoxShadows>

    <Thickness x:Key="CodeWFLogDesktopNotificationTitleBarBorderThickness">0</Thickness>
    <CornerRadius x:Key="CodeWFLogDesktopNotificationTitleBarCornerRadius">8 8 0 0</CornerRadius>
    <x:Double x:Key="CodeWFLogDesktopNotificationLevelSectionHeight">80</x:Double>
    <x:Double x:Key="CodeWFLogDesktopNotificationContentMaxHeight">190</x:Double>

    <!-- Error 与 Critical 是默认重要通知视觉；其他级别保留原扩展资源。 -->
    <StreamGeometry x:Key="CodeWFLogDesktopNotificationDebugIconData">M9,3V5H7V7H5V9H3V11H5V13H3V15H5V17H7V19H9V21H11V19H13V21H15V19H17V17H19V15H21V13H19V11H21V9H19V7H17V5H15V3H13V5H11V3H9M8,8H16V16H8V8Z</StreamGeometry>
    <StreamGeometry x:Key="CodeWFLogDesktopNotificationInfoIconData">M11,17H13V11H11V17M12,2A10,10 0 1 0 12,22A10,10 0 0 0 12,2M11,7V9H13V7H11Z</StreamGeometry>
    <StreamGeometry x:Key="CodeWFLogDesktopNotificationWarnIconData">M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z</StreamGeometry>
    <StreamGeometry x:Key="CodeWFLogDesktopNotificationErrorIconData">M12,2A10,10 0 1 0 12,22A10,10 0 0 0 12,2M11,6H13V14H11V6M11,16H13V18H11V16Z</StreamGeometry>
    <StreamGeometry x:Key="CodeWFLogDesktopNotificationFatalIconData">M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z</StreamGeometry>
</ResourceDictionary>
