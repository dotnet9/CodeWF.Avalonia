<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>官方 Avalonia DataGrid 的增强扩展：三态排序（升/降/取消）、自然排序比较器与智能 ToolTip，内置 Semi 主题入口。Enhancements for the Avalonia DataGrid control with a built-in Semi theme entry.</Description>
    <PackageTags>avalonia;datagrid;semiv;codewf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
