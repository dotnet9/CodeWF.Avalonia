<Styles
    x:Class="CodeWF.Avalonia.Dock.Themes.DockSemiTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:simple="clr-namespace:Dock.Avalonia.Themes.Simple;assembly=Dock.Avalonia.Themes.Simple">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Semi.Avalonia/Controls/Button.axaml" />
                <ResourceInclude Source="avares://Semi.Avalonia/Controls/Window.axaml" />
                <ResourceInclude Source="Locales/en-us.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!--
        CodeWF.Avalonia.Dock 的 Semi 皮肤，基座是 Dock 官方的 Simple 主题（完全不依赖 Fluent）：
          1. simple:DockSimpleTheme —— Dock 控件模板与几何（Simple 与 Fluent 共用同一批模板，仅换配色）；
          2. Tokens                 —— 6 套变体的 Semi 配色令牌（字面色值，启动期不依赖 Semi 包字典）；
          3. Styles.Resources       —— 直接复用 Semi 的按钮和窗口模板，满足 Dock 的静态资源作用域；
          4. Simple/*               —— CodeWF 的皮肤覆盖：面板圆角、文档页签、工具标题栏。
        不再提供全局的简化 Button / Window 模板，避免覆盖宿主的 Semi 样式和窗口浮层。
        DockSimpleTheme 位于皮肤覆盖之前，供后续 StyleInclude 解析 Dock 资源。
    -->
    <simple:DockSimpleTheme />
    <StyleInclude Source="Tokens/DockSurfaceTokens.axaml" />
    <StyleInclude Source="Simple/CodeWF.axaml" />
    <StyleInclude Source="Simple/Documents.axaml" />
    <StyleInclude Source="Simple/Tools.axaml" />
</Styles>
