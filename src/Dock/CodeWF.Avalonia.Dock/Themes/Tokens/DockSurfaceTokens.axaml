<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:semi="https://irihi.tech/semi">
    <!--
        Dock 表面令牌：6 套变体（Default/Light/Dark + Semi 四套高对比色板），
        色值取半调色板并预先合成 alpha。高对比色板在 Semi 里只有语义令牌
        （Window / WindowText / GrayText / Hotlight / Highlight），故此处按变体字面落地，
        启动期不依赖 Semi 包字典，也不受数字令牌回落 Light 的影响。
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush">#0D2E3238</SolidColorBrush>
                    <SolidColorBrush x:Key="DockSurfaceSidebarBrush">#FFFFFFFF</SolidColorBrush>
