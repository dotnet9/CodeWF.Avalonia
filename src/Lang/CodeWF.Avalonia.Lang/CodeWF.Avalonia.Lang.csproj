<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Avalonia 国际化绑定：I18n 标记扩展与转换器，直接使用 CodeWF.Toolkit.Lang 唯一管理器、资源加载器与文化回退。Avalonia localization bindings for the shared CodeWF.Toolkit.Lang engine.</Description>
    <PackageTags>avalonia;i18n;localization;lang;codewf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CodeWF.Toolkit.Lang" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
