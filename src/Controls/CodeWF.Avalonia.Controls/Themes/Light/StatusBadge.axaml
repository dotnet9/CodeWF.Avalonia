<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="StatusBadgeLeftTextForeground">White</SolidColorBrush>
    <StaticResource x:Key="StatusBadgeStatusTextForeground" ResourceKey="StatusBadgeLeftTextForeground" />
    <StaticResource x:Key="StatusBadgeRightTextForeground" ResourceKey="SemiColorText0" />
    <SolidColorBrush x:Key="StatusBadgeDebugBorderBrush">#175CD3</SolidColorBrush>
    <SolidColorBrush x:Key="StatusBadgeInfoBorderBrush">#15803D</SolidColorBrush>
    <SolidColorBrush x:Key="StatusBadgeWarnBorderBrush">#925C00</SolidColorBrush>
    <SolidColorBrush x:Key="StatusBadgeErrorBorderBrush">#B42318</SolidColorBrush>
    <SolidColorBrush x:Key="StatusBadgeFatalBorderBrush">#912018</SolidColorBrush>
    <StaticResource x:Key="StatusBadgeDebugBackground" ResourceKey="SemiColorInformationLight" />
    <StaticResource x:Key="StatusBadgeInfoBackground" ResourceKey="SemiColorSuccessLight" />
    <StaticResource x:Key="StatusBadgeWarnBackground" ResourceKey="SemiColorWarningLight" />
    <StaticResource x:Key="StatusBadgeErrorBackground" ResourceKey="SemiColorDangerLight" />
    <StaticResource x:Key="StatusBadgeFatalBackground" ResourceKey="SemiColorDangerLightActive" />
</ResourceDictionary>