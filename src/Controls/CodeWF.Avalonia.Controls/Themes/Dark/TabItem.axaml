<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="TrapezoidShapedTabItemContentBackground" Color="Transparent" />
    <!-- 制表栏/页签分隔线与标题栏底边框共用（深色 Semi 边框色：SemiWhite @8%） -->
    <SolidColorBrush x:Key="TabControlSeparatorBorderBrush">#14FFFFFF</SolidColorBrush>
</ResourceDictionary>