<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  12.1.4 启动窗口期 Semi 包字典不可达，Semi 色内联字面量（SemiColorText1 深色 = #F9F9F9 @0.8）  -->
