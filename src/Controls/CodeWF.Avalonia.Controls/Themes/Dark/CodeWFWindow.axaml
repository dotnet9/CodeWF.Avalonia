<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  12.1.4 启动窗口期 Semi 包字典不可达，Semi 窗口色内联字面量（对齐 Semi Dark 调色板取值）  -->
    <SolidColorBrush x:Key="CodeWFWindowBackground">#FF16161A</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFWindowForeground">#FFF9F9F9</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFWindowTitleBarBackground">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFWindowTitleBarForeground">#CCF9F9F9</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFWindowTitleBarBorderBrush">#14FFFFFF</SolidColorBrush>
</ResourceDictionary>
