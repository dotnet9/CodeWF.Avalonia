<Styles xmlns="https://github.com/avaloniaui"
        xmlns:ac="https://codewf.com">
    <!-- 分段选择器的画法配方：轨道 + 一颗滑动伸缩的指示块，选中项只换字色字重，底色绝不自画。
         颜色一律取 Studio 派生令牌（随九套配色与明暗走），几何留给宿主：轨道圆角写在自己的
         Border 上，指示块圆角由 SegmentedPanel.CornerRadius 给出，两者应当一致。 -->
    <Style Selector="Border.segmented-track">
        <Setter Property="Background">
            <SolidColorBrush Color="{DynamicResource StudioSegmentedTrackColor}" />
        </Setter>
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 指示块：原型 .vex-segmented-thumb 的浮起靠 1px 4px 的 12% 墨投影，不靠描边；
         位移与伸缩用慢档缓动，淡出用快档线性，鼠标点击不改变它自己的命中。 -->
    <Style Selector="ac|SegmentedPanel > Border.segmented-thumb">
        <Setter Property="Background">
            <SolidColorBrush Color="{DynamicResource StudioSegmentedThumbColor}" />
        </Setter>
        <Setter Property="BoxShadow" Value="0 1 4 0 #1F000000" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="CubicEaseInOut" />
                <ThicknessTransition Property="Margin" Duration="0:0:0.26" Easing="CubicEaseInOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="Linear" />
            </Transitions>
        </Setter>
    </Style>

    <!-- 分段按钮：三态底色一律透明，未选静音色、悬停转正文色、选中转强调色并加粗。
         基准高、内距与字号属于各宿主自己的版面，这里不代定。 -->
    <Style Selector="ac|SegmentedPanel Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Foreground">
            <SolidColorBrush Color="{DynamicResource StudioMutedColor}" />
        </Setter>
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- 等宽档（FillItems）由面板给出槽宽后按钮要撑满槽，指示块才量到整段宽。 -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ac|SegmentedPanel Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ac|SegmentedPanel Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ac|SegmentedPanel Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ac|SegmentedPanel Button:pointerover">
        <Setter Property="Foreground">
            <SolidColorBrush Color="{DynamicResource StudioTextColor}" />
        </Setter>
    </Style>
    <Style Selector="ac|SegmentedPanel Button.active">
        <Setter Property="Foreground">
            <SolidColorBrush Color="{DynamicResource StudioAccentColor}" />
        </Setter>
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ac|SegmentedPanel Button.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 图标随 currentColor 走：分段按钮里的描线图标只用文字色，描线口径留给各宿主自己定。 -->
    <Style Selector="ac|SegmentedPanel Button Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>
</Styles>
