<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  12.1.4 延迟字典内 StaticResource 仅文件内解析，Semi token 一律内联字面量（对齐 Semi Tokens 取值）  -->
    <x:Double x:Key="CodeWFTitleBarMinHeight">32</x:Double>
    <Thickness x:Key="CodeWFTitleBarLeftContentMargin">8,0,10,0</Thickness>
    <x:Double x:Key="CodeWFTitleBarIconSize">16</x:Double>
    <x:Double x:Key="CodeWFTitleBarDefaultContentSpacing">8</x:Double>
</ResourceDictionary>
