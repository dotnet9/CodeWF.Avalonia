<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themes="using:CodeWF.Avalonia.Controls.Themes">
<ResourceDictionary.ThemeDictionaries>
<ResourceInclude x:Key="Default" Source="DefaultLight.axaml"/>
<ResourceInclude x:Key="Light" Source="DefaultLight.axaml"/>
<ResourceInclude x:Key="Dark" Source="DefaultDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.WeftLight}" Source="WeftLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.WeftDark}" Source="WeftDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.GraphiteLight}" Source="GraphiteLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.GraphiteDark}" Source="GraphiteDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.OceanLight}" Source="OceanLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.OceanDark}" Source="OceanDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.SandLight}" Source="SandLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.SandDark}" Source="SandDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.RoseLight}" Source="RoseLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.RoseDark}" Source="RoseDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.IrisLight}" Source="IrisLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.IrisDark}" Source="IrisDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.OliveLight}" Source="OliveLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.OliveDark}" Source="OliveDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.TerracottaLight}" Source="TerracottaLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.TerracottaDark}" Source="TerracottaDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.DotNetLight}" Source="DotNetLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.DotNetDark}" Source="DotNetDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.AuroraLight}" Source="AuroraLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.AuroraDark}" Source="AuroraDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.EmberLight}" Source="EmberLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.EmberDark}" Source="EmberDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.AquaticLight}" Source="AquaticLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.AquaticDark}" Source="AquaticDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.DesertLight}" Source="DesertLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.DesertDark}" Source="DesertDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.DuskLight}" Source="DuskLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.DuskDark}" Source="DuskDark.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.NightSkyLight}" Source="NightSkyLight.axaml"/>
<ResourceInclude x:Key="{x:Static themes:StudioTheme.NightSkyDark}" Source="NightSkyDark.axaml"/>
</ResourceDictionary.ThemeDictionaries>
<SolidColorBrush x:Key="StudioSwatchWeft">#24766B</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchGraphite">#4F5662</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchOcean">#2F68B3</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchSand">#94651E</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchRose">#A13D6A</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchIris">#7053AD</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchOlive">#657A2B</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchTerracotta">#B35431</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchDotNet">#512BD4</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchAurora">#6745D6</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchEmber">#A94F36</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchDefault">#005DE8</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchAquatic">#007184</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchDesert">#8A591A</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchDusk">#7052B5</SolidColorBrush>
<SolidColorBrush x:Key="StudioSwatchNightSky">#235FAD</SolidColorBrush>
</ResourceDictionary>
