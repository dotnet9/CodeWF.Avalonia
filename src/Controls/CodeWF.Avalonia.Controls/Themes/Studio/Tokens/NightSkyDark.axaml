    <StaticResource x:Key="ComboBoxSelectorPressedBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="ComboBoxItemSelectedBackground" ResourceKey="StudioRaised" />
    <StaticResource x:Key="ComboBoxItemSelectedPointeroverBackground" ResourceKey="StudioBorder" />
    <StaticResource x:Key="ComboBoxSelectorBorderedPointeroverBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="ComboBoxSelectorBorderedFocusBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="ComboBoxSelectorBorderedPressedBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="CommandBarToggleButtonCheckedForeground" ResourceKey="StudioAccent" />
    <StaticResource x:Key="CommandBarToggleButtonCheckedBackground" ResourceKey="StudioRaised" />
    <StaticResource x:Key="CommandBarToggleButtonCheckedPointeroverBackground" ResourceKey="StudioBorder" />
    <StaticResource x:Key="CommandBarToggleButtonCheckedPressedBackground" ResourceKey="StudioBorder" />
    <StaticResource x:Key="CommandBarToggleButtonCheckedDisabledForeground" ResourceKey="StudioPrimaryDisabled" />
    <StaticResource x:Key="GlyphButtonPointeroverForeground" ResourceKey="StudioAccent" />
    <StaticResource x:Key="GlyphButtonPressedForeground" ResourceKey="StudioAccent" />
    <StaticResource x:Key="GridSplitterPreviewBackground" ResourceKey="StudioBorder" />
    <StaticResource x:Key="ListBoxItemSelectedBackground" ResourceKey="StudioRaised" />
    <StaticResource x:Key="ListBoxItemSelectedPointeroverBackground" ResourceKey="StudioBorder" />
    <StaticResource x:Key="ProgressBarIndicatorBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="ProgressBarPrimaryForeground" ResourceKey="StudioAccent" />
    <StaticResource x:Key="RadioButtonUncheckIconPointeroverBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="RadioButtonUncheckIconPressedBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="RadioButtonCheckIconDefaultBackground" ResourceKey="StudioPrimary" />
    <StaticResource x:Key="RadioButtonCheckIconPointeroverBackground" ResourceKey="StudioPrimary" />
    <StaticResource x:Key="RadioButtonCheckIconPressedBackground" ResourceKey="StudioPrimary" />
    <StaticResource x:Key="RadioButtonCheckIconDisabledBackground" ResourceKey="StudioPrimaryDisabled" />
    <StaticResource x:Key="RadioButtonCheckIconDefaultBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="RadioButtonCheckIconPointeroverBorderBrush" ResourceKey="StudioAccent" />
