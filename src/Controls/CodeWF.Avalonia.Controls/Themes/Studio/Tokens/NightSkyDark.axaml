    <StaticResource x:Key="TextBoxBorderedPointeroverBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="ToggleButtonPrimaryIndeterminateBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="TreeViewItemSelectedBackground" ResourceKey="StudioRaised" />
</ResourceDictionary>
