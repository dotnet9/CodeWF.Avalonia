    <StaticResource x:Key="RadioButtonCardCheckPressedBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="RefreshVisualizerIconForeground" ResourceKey="StudioAccent" />
    <StaticResource x:Key="SliderTrackForeground" ResourceKey="StudioAccent" />
    <StaticResource x:Key="SliderThumbBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="SliderThumbPointeroverBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="SliderThumbPressedBorderBrush" ResourceKey="StudioAccent" />
    <StaticResource x:Key="TabItemLinePipeSelectedBackground" ResourceKey="StudioAccent" />
    <StaticResource x:Key="TabItemLineHeaderSelectedBackground" ResourceKey="StudioRaised" />
    <StaticResource x:Key="TabItemButtonHeaderSelectedForeground" ResourceKey="StudioAccent" />
