<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>社区版 TreeDataGrid.Avalonia 的增强扩展：三态排序（升/降/取消）、Ctrl+A 全选与智能 ToolTip，内置 Semi 主题（本地 vendor 副本，不依赖商业版 TreeDataGrid）；另含通用属性面板控件 PropertyGrid（对标 Visual Studio 属性窗口：分类/字母双视图、无限层级、搜索、描述面板、多类型编辑器）。Enhancements for the community TreeDataGrid.Avalonia control with a vendored Semi theme, plus a generic PropertyGrid control.</Description>
    <PackageTags>avalonia;treedatagrid;semi;codewf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="PropertyGrid\I18n\*.json" WithCulture="false" />
    <PackageReference Include="TreeDataGrid.Avalonia" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同仓项目必须走 ProjectReference：走 PackageReference 时 CI 会去 nuget.org 找本仓
         尚未发布的版本号（如 12.1.4.2），全新检出直接还原失败。 -->
    <ProjectReference Include="..\..\Lang\CodeWF.Avalonia.Lang\CodeWF.Avalonia.Lang.csproj" />
  </ItemGroup>

</Project>
