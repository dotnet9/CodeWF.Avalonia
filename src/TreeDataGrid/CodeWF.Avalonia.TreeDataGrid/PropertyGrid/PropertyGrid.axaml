<UserControl
    x:Class="CodeWF.Avalonia.TreeDataGrid.PropertyGrid.PropertyGrid"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pg="using:CodeWF.Avalonia.TreeDataGrid.PropertyGrid"
    x:Name="Root">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PgBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PgToolbarBackground" Color="#F7F8FA" />
          <SolidColorBrush x:Key="PgGroupBackground" Color="#F2F3F5" />
          <SolidColorBrush x:Key="PgForeground" Color="#1D2129" />
          <SolidColorBrush x:Key="PgSecondaryForeground" Color="#6B7075" />
          <SolidColorBrush x:Key="PgBorder" Color="#E2E4E8" />
          <SolidColorBrush x:Key="PgLine" Color="#DADDE3" />
          <SolidColorBrush x:Key="PgHover" Color="#F4F6F8" />
          <SolidColorBrush x:Key="PgAccent" Color="#1667D9" />
          <SolidColorBrush x:Key="PgSelected" Color="#1667D9" />
          <SolidColorBrush x:Key="PgSelectedSoft" Color="#1A1667D9" />
          <SolidColorBrush x:Key="PgSelectedText" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PgEditorBackground" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PgBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="PgToolbarBackground" Color="#232323" />
          <SolidColorBrush x:Key="PgGroupBackground" Color="#282829" />
          <SolidColorBrush x:Key="PgForeground" Color="#D4D4D4" />
          <SolidColorBrush x:Key="PgSecondaryForeground" Color="#9A9A9A" />
          <SolidColorBrush x:Key="PgBorder" Color="#333336" />
          <SolidColorBrush x:Key="PgLine" Color="#414148" />
          <SolidColorBrush x:Key="PgHover" Color="#3A3A3D" />
          <SolidColorBrush x:Key="PgAccent" Color="#0F6FDF" />
          <SolidColorBrush x:Key="PgSelected" Color="#0F6FDF" />
          <SolidColorBrush x:Key="PgSelectedSoft" Color="#260F6FDF" />
          <SolidColorBrush x:Key="PgSelectedText" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PgEditorBackground" Color="#2A2A2B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <pg:NullableDoubleToHeightConverter x:Key="NullableHeightConverter" />
      <pg:DepthToThicknessConverter x:Key="DepthIndentConverter" />
      <pg:DepthToGuidesConverter x:Key="DepthGuidesConverter" />
      <pg:BoolToChevronConverter x:Key="ChevronConverter" />
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 工具栏 -->    <Style Selector="Border.pg-toolbar">
      <Setter Property="Background" Value="{DynamicResource PgToolbarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PgBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="ToggleButton.pg-view">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PgSecondaryForeground}" />
    </Style>
    <Style Selector="ToggleButton.pg-view:checked">
      <Setter Property="Foreground" Value="{DynamicResource PgAccent}" />
    </Style>
    <Style Selector="Border.pg-searchbox">
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,5,0,0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource PgBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource PgEditorBackground}" />
    </Style>
    <Style Selector="TextBox.pg-search">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pg-mini-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource PgSecondaryForeground}" />
    </Style>

    <!-- 属性行 -->    <Style Selector="Grid.pg-row, Border.pg-row">
      <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>
    <Style Selector="Grid.pg-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource PgHover}" />
    </Style>
    <Style Selector="Grid.pg-row.selected">
      <Setter Property="Background" Value="{DynamicResource PgSelectedSoft}" />
    </Style>
    <Style Selector="Border.pg-name">
      <Setter Property="BorderBrush" Value="{DynamicResource PgLine}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.pg-name.selected">
      <Setter Property="Background" Value="{DynamicResource PgSelected}" />
    </Style>
    <Style Selector="Border.pg-value">
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- 值列保持表格外观，编辑器占满单元格；焦点由底色和光标表达。 -->
    <Style Selector="TextBox.pg-input, NumericUpDown.pg-input, ComboBox.pg-input">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.pg-input:focus, NumericUpDown.pg-input:focus-within, ComboBox.pg-input:focus">
      <Setter Property="Background" Value="{DynamicResource PgEditorBackground}" />
    </Style>
    <Style Selector="TextBlock.pg-name">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.pg-name.modified">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource PgForeground}" />
    </Style>
    <Style Selector="Border.pg-name.selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PgSelectedText}" />
    </Style>
    <Style Selector="TextBlock.pg-expander">
      <Setter Property="Width" Value="14" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource PgSecondaryForeground}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.pg-expander:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource PgForeground}" />
    </Style>
    <Style Selector="TextBlock.pg-group-name">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.pg-readonly">
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Foreground" Value="{DynamicResource PgSecondaryForeground}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.pg-summary">
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Foreground" Value="{DynamicResource PgSecondaryForeground}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.pg-unit">
      <Setter Property="Foreground" Value="{DynamicResource PgSecondaryForeground}" />
    </Style>
    <Style Selector="TextBlock.pg-spin-button">
      <Setter Property="Width" Value="15" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource PgSecondaryForeground}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.pg-spin-button:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource PgAccent}" />
    </Style>
    <Style Selector="Border.pg-swatch">
      <Setter Property="BorderBrush" Value="{DynamicResource PgBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pg-full-button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Foreground" Value="{DynamicResource PgSecondaryForeground}" />
    </Style>

    <!-- 层级缩进线 -->    <Style Selector="ItemsControl.pg-guides">
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- 列宽拖拽命中区域 -->    <Style Selector="Border.pg-col-handle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="7" />
      <Setter Property="Margin" Value="-3,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="ZIndex" Value="3" />
    </Style>

    <!-- 贯穿属性行的行高拖拽区域 -->    <Style Selector="Border.pg-row-line">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Height" Value="7" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,0,-3" />
      <Setter Property="ZIndex" Value="4" />
      <Setter Property="Cursor" Value="SizeNorthSouth" />
    </Style>
    <Style Selector="Border.pg-row-line > Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource PgLine}" />
    </Style>
    <Style Selector="Border.pg-row-line:pointerover > Border">
      <Setter Property="Background" Value="{DynamicResource PgAccent}" />
    </Style>

    <!-- 属性说明区 -->    <Style Selector="Border.pg-desc">
      <Setter Property="Background" Value="{DynamicResource PgToolbarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PgBorder}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.pg-desc-name">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource PgForeground}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style Selector="TextBlock.pg-desc-text">
      <Setter Property="Foreground" Value="{DynamicResource PgSecondaryForeground}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="640" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" Background="{DynamicResource PgBackground}" TextElement.Foreground="{DynamicResource PgForeground}">

    <!-- 分类与字母排序，下一行搜索 -->    <Border Grid.Row="0" Classes="pg-toolbar" IsVisible="{Binding ShowToolBar, ElementName=Root}">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto">
        <ToggleButton Grid.Column="0" x:Name="CategorizedButton" Classes="pg-view" Click="OnCategorizedClick">
          <PathIcon Width="18" Height="18" Data="{DynamicResource SemiIconListView}" />
        </ToggleButton>
        <ToggleButton Grid.Column="1" x:Name="AlphabetButton" Classes="pg-view" Click="OnAlphabetClick">
          <PathIcon Width="18" Height="18" Data="{DynamicResource SemiIconSort}" />
        </ToggleButton>

        <Border Grid.Row="1" Grid.ColumnSpan="4" Classes="pg-searchbox">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <PathIcon Grid.Column="0" Width="16" Height="16" Foreground="{DynamicResource PgSecondaryForeground}"
                      Data="{DynamicResource SemiIconSearch}" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="SearchBox" Classes="pg-search"
                     Text="{Binding SearchText, ElementName=Root, Mode=TwoWay}"
                     TextChanged="OnSearchTextChanged" />
            <Button Grid.Column="2" x:Name="ClearSearchButton" Classes="pg-mini-button" Click="OnClearSearchClick"
                    IsVisible="False" >
              <TextBlock Text="✕" FontSize="10" />
            </Button>
          </Grid>
        </Border>

        <Button Grid.Column="3" x:Name="MoreButton" Classes="pg-mini-button" Focusable="False">
          <Path Fill="{DynamicResource PgSecondaryForeground}" Stretch="None"
                Data="M3,8 a1.4,1.4 0 1 0 0.02,0 M8,8 a1.4,1.4 0 1 0 0.02,0 M13,8 a1.4,1.4 0 1 0 0.02,0" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem x:Name="ExpandAllItem" Click="OnExpandAllClick" />
              <MenuItem x:Name="CollapseAllItem" Click="OnCollapseAllClick" />
              <Separator />
              <MenuItem x:Name="DescriptionToggleItem" Click="OnDescriptionToggleClick" />
              <Separator />
              <MenuItem x:Name="ResetAllItem" Click="OnResetAllClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- 属性行列表 -->    <ScrollViewer Grid.Row="1" x:Name="RowsScroll">
      <ItemsControl x:Name="RowsHost">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>

          <!-- 分类标题行 -->          <DataTemplate x:DataType="pg:PropertyCategoryRow" DataType="pg:PropertyCategoryRow">
            <Border Classes="pg-row"
                    Background="{DynamicResource PgGroupBackground}"
                    MinHeight="{Binding DefaultRowHeight, ElementName=Root}"
                    Height="{Binding Item.RowHeight, Converter={x:Static pg:NullableDoubleToHeightConverter.Instance}}"
                    PointerPressed="OnCategoryPressed">
              <Panel>
                <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={x:Static pg:DepthToThicknessConverter.Instance}}">
                  <ItemsControl Classes="pg-guides" ItemsSource="{Binding Depth, Converter={x:Static pg:DepthToGuidesConverter.Instance}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Height="18" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="1" Margin="6,0,10,0" Background="{DynamicResource PgLine}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="pg-expander" IsVisible="{Binding Item.HasChildren}"
                             Text="{Binding Item.IsExpanded, Converter={x:Static pg:BoolToChevronConverter.Instance}}" />
                  <TextBlock Classes="pg-group-name" Text="{Binding Item.Name}" />
                </StackPanel>
                <Border Classes="pg-row-line" Tag="{Binding Item}"
                        PointerPressed="OnRowLinePressed" DoubleTapped="OnRowLineDoubleTapped">
                  <Border />
                </Border>
              </Panel>
            </Border>
          </DataTemplate>

          <!-- 属性行 -->          <DataTemplate x:DataType="pg:PropertyLeafRow" DataType="pg:PropertyLeafRow">
            <Grid Classes="pg-row" Classes.selected="{Binding Item.IsSelected}"
                  MinHeight="{Binding DefaultRowHeight, ElementName=Root}"
                  Height="{Binding Item.RowHeight, Converter={x:Static pg:NullableDoubleToHeightConverter.Instance}}"
                  ColumnDefinitions="Auto,*"
                  PointerPressed="OnRowPressed">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{x:Static pg:PropertyGridChrome.ResetToDefault}" IsEnabled="{Binding Item.IsModifiedDeep}" Click="OnResetRowClick" />
                  <MenuItem Header="{x:Static pg:PropertyGridChrome.ToggleChildren}" IsVisible="{Binding ShowExpander}" Click="OnToggleRowClick" />
                </ContextMenu>
              </Grid.ContextMenu>

              <!-- 名称单元格 -->              <Border Grid.Column="0" Classes="pg-name" Classes.selected="{Binding Item.IsSelected}"
                      Width="{Binding NameColumnWidth, ElementName=Root}">
                <Panel>
                  <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={x:Static pg:DepthToThicknessConverter.Instance}}">
                    <ItemsControl Classes="pg-guides" ItemsSource="{Binding Depth, Converter={x:Static pg:DepthToGuidesConverter.Instance}}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Height="18" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="1" Margin="6,0,10,0" Background="{DynamicResource PgLine}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="pg-expander" IsVisible="{Binding ShowExpander}"
                               Text="{Binding Item.IsExpanded, Converter={x:Static pg:BoolToChevronConverter.Instance}}"
                               PointerReleased="OnExpanderClick" />
                    <TextBlock Classes="pg-name" Classes.modified="{Binding Item.IsModifiedDeep}"
                               Text="{Binding Item.Name}" Margin="0,0,8,0" />
                  </StackPanel>
                  <Border Classes="pg-col-handle" PointerPressed="OnColumnHandlePressed" />
                </Panel>
              </Border>

              <!-- 值单元格 -->              <Border Grid.Column="1" Classes="pg-value">
                <pg:PropertyCellEditor />
              </Border>

              <!-- 贯穿整行的分隔线 -->              <Border Grid.ColumnSpan="2" Classes="pg-row-line" Tag="{Binding Item}"
                      PointerPressed="OnRowLinePressed" DoubleTapped="OnRowLineDoubleTapped">
                <Border />
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
    </ScrollViewer>

    <!-- 属性说明区 -->    <Border Grid.Row="2" Classes="pg-desc" IsVisible="{Binding ShowDescriptionPane, ElementName=Root}">
      <StackPanel Margin="12,8">
        <TextBlock Classes="pg-desc-name" Text="{Binding SelectedItem.Name, ElementName=Root}" />
        <TextBlock Classes="pg-desc-text"
                   IsVisible="{Binding SelectedItem, ElementName=Root, Converter={x:Static pg:NullToBoolConverter.InverseInstance}}"
                   Text="{Binding SelectedItem.Description, ElementName=Root}" />
        <TextBlock x:Name="DescPlaceholderText" Classes="pg-desc-text"
                   IsVisible="{Binding SelectedItem, ElementName=Root, Converter={x:Static pg:NullToBoolConverter.Instance}}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
