<#@ assembly name="System.Core" #>
<#@ assembly name="System.Text.Json" #>
<#@ assembly name="System.Runtime" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Text.Json" #>
<#
var templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
using (var document = JsonDocument.Parse(File.ReadAllText(Directory.GetFiles(templateDirectory, "*en-US.json").Single())))
{
    var root = new ResourceNode();
    Collect(document.RootElement, "", root);
#>
// <auto-generated>由 Language.tt 根据 en-US.json 生成，请勿手动修改。</auto-generated>
namespace <#= resourceNamespace #>;

public static class ResourceKeys
{
<# Render(root, 1); #>
}
<# } #>
<#+
private sealed class ResourceNode
{
    public string Key;
    public SortedDictionary<string, ResourceNode> Children = new SortedDictionary<string, ResourceNode>(StringComparer.Ordinal);
}

private void Collect(JsonElement element, string path, ResourceNode root)
{
    if (element.ValueKind == JsonValueKind.Object)
    {
        foreach (var property in element.EnumerateObject())
            Collect(property.Value, path.Length == 0 ? property.Name : path + "." + property.Name, root);
        return;
    }
    if (!path.StartsWith(resourcePrefix, StringComparison.Ordinal)) return;
    if (element.ValueKind != JsonValueKind.String) throw new InvalidOperationException("Expected a translation string: " + path);
    var node = root;
    foreach (var segment in path.Substring(resourcePrefix.Length).Split('.'))
    {
        if (segment.Length == 0 || segment.Any(c => !(char.IsLetterOrDigit(c) || c == '_')))
            throw new InvalidOperationException("Unsupported resource key identifier: " + path);
        ResourceNode child;
        if (!node.Children.TryGetValue(segment, out child)) node.Children.Add(segment, child = new ResourceNode());
        node = child;
    }
    if (node.Key != null) throw new InvalidOperationException("Duplicate resource key: " + path);
    node.Key = path;
}

private void Render(ResourceNode node, int depth)
{
    var indent = new string(' ', depth * 4);
    foreach (var entry in node.Children)
    {
        var identifier = char.IsDigit(entry.Key[0]) ? "_" + entry.Key : entry.Key;
        if (entry.Value.Key != null)
        {
            if (entry.Value.Children.Count != 0) throw new InvalidOperationException("Resource key is both a value and an object: " + entry.Value.Key);
            WriteLine(indent + "public const string @" + identifier + " = " + JsonSerializer.Serialize(entry.Value.Key) + ";");
        }
        else
        {
            WriteLine(indent + "public static class @" + identifier);
            WriteLine(indent + "{");
            Render(entry.Value, depth + 1);
            WriteLine(indent + "}");
        }
    }
}
#>
