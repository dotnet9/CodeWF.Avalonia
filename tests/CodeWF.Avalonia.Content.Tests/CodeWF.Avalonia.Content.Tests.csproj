<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- 源码树侧断言需要稳定定位仓库根：本仓产物整体重定向到仓库外，CI 确定性编译还会把
         CallerFilePath 重写为 /_/ 前缀，运行时两路都爬不到源码树。编译期钉进程序集元数据
         （与 StudioTokenParityTests 同式，CI 与本地同源）。 -->
    <AssemblyMetadata Include="RepositoryRoot"
                      Value="$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildThisFileDirectory)', 'CodeWF.Avalonia.slnx'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="TreeDataGrid.Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Dock.Model.ReactiveUI" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MindView/CodeWF.Avalonia.MindView/CodeWF.Avalonia.MindView.csproj" />
    <ProjectReference Include="..\..\src\Controls\CodeWF.Avalonia.Controls\CodeWF.Avalonia.Controls.csproj" />
    <ProjectReference Include="..\..\src\Markdown\CodeWF.Avalonia.Markdown.Lite\CodeWF.Avalonia.Markdown.Lite.csproj" />
    <ProjectReference Include="..\..\src\Markdown\CodeWF.Avalonia.Markdown\CodeWF.Avalonia.Markdown.csproj" />
    <ProjectReference Include="..\..\src\TreeDataGrid\CodeWF.Avalonia.TreeDataGrid\CodeWF.Avalonia.TreeDataGrid.csproj" />
    <ProjectReference Include="..\..\src\DataGrid\CodeWF.Avalonia.DataGrid\CodeWF.Avalonia.DataGrid.csproj" />
    <ProjectReference Include="..\..\src\Dock\CodeWF.Avalonia.Dock\CodeWF.Avalonia.Dock.csproj" />
    <ProjectReference Include="..\..\src\Lang\CodeWF.Avalonia.Lang\CodeWF.Avalonia.Lang.csproj" />
    <ProjectReference Include="..\..\src\Motion\CodeWF.Avalonia.Motion\CodeWF.Avalonia.Motion.csproj" />
    <ProjectReference Include="..\..\src\Lang\CodeWF.Avalonia.Lang.Generator\CodeWF.Avalonia.Lang.Generator.csproj" />
    <ProjectReference Include="..\..\src\Log\CodeWF.Avalonia.Log\CodeWF.Avalonia.Log.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\embedded.json" />
    <EmbeddedResource Include="Markdown\Streaming\Fixtures\**\*.json" />
  </ItemGroup>

</Project>
