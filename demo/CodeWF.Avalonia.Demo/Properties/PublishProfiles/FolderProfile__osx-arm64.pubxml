<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="FolderProfile.Common.props" />
  <PropertyGroup>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Xcode 16 新链接器处理完整 AOT 元数据时可能触发 Fixup::addend 断言，改用经典链接器。 -->
    <CompressSymbols>false</CompressSymbols>
  </PropertyGroup>
  <ItemGroup>
    <LinkerArg Include="-Wl,-ld_classic" />
  </ItemGroup>
</Project>
