<prism:PrismApplication xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:prism="http://prismlibrary.com"
                        xmlns:semi="https://irihi.tech/semi"
                        xmlns:codewf="https://codewf.com"
                        x:Class="CodeWF.Avalonia.Demo.App"
                        RequestedThemeVariant="Dark">
  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />
    <codewf:ACSemiTheme />
    <codewf:DataGridSemiTheme />
    <codewf:TreeDataGridSemiTheme />
    <codewf:DockSemiTheme />
    <codewf:CodeWFLogTheme />
    <codewf:MarkdownFullThemes />
    <!--  演示台外壳样式：与设计原型对齐（间距 / 四态 / 命令按钮 / 步骤条）  -->
    <StyleInclude Source="avares://CodeWF.Avalonia.Demo/Views/DemoShellStyles.axaml" />
    <codewf:StudioTheme />
    <Style Selector="codewf|PropertyGrid">
      <Setter Property="ThemeOverrides" Value="{DynamicResource StudioPropertyGridTheme}" />
    </Style>
  </Application.Styles>
</prism:PrismApplication>
