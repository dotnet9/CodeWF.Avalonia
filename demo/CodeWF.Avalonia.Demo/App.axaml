<prism:PrismApplication xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:prism="http://prismlibrary.com"
                        xmlns:semi="https://irihi.tech/semi"
                        xmlns:codewf="https://codewf.com"
                        x:Class="CodeWF.Avalonia.Demo.App"
                        RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <semi:SemiTheme Locale="zh-CN" />
    <codewf:ACSemiTheme />
    <!-- 已知问题：Avalonia 12.1.4 下 Semi DataGrid 主题 parse 期 StaticResource 解析失败，演示页暂用默认 DataGrid 皮肤，详见 UpdateLog 待治理 -->
    <codewf:TreeDataGridSemiTheme />
    <codewf:DockSemiTheme />
  </Application.Styles>
</prism:PrismApplication>
