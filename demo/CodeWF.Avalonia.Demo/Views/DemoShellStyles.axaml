<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--  演示台外壳样式：与设计原型对齐（间距 / 四态 / 命令按钮 / 状态栏 / 步骤条）  -->

  <!--  快捷工具按钮：28×26 热区、字形居中、悬停与键盘焦点四态  -->
  <Style Selector="Button.qk-btn,ToggleButton.qk-btn">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!--  Ribbon 命令按钮：72×68 热区、图标 20 / 文字 11、悬停轻抬  -->
  <Style Selector="Button.rbn-cmd">
    <Setter Property="Width" Value="72" />
    <Setter Property="MinHeight" Value="66" />
    <Setter Property="Padding" Value="6,8,6,6" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rbn-cmd:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>

  <!--  状态栏按钮：透明底、悬停加底色  -->
  <Style Selector="Button.st-btn">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.st-btn:pointerover">
    <Setter Property="Background" Value="#14000000" />
  </Style>

  <!--  面板头部：标题 + 计数 + 右侧工具按钮  -->
  <Style Selector="TextBlock.panel-head">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.72" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--  场景页步骤条：轨道式步骤，当前高亮、已完成打勾  -->
  <Style Selector="Button.scene-step">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#22000000" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.scene-step:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <Style Selector="Button.scene-step.active">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Background" Value="#1A0078D7" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="#22000000" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no.done">
    <Setter Property="Background" Value="#2626a34a" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
</Styles>
