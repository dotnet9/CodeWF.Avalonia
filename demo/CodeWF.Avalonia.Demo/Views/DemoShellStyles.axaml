<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shapes="using:Avalonia.Controls.Shapes">
  <!--  演示台外壳样式：与设计原型对齐（间距 / 四态 / 命令按钮 / 状态栏 / 步骤条）  -->

  <!--  快捷工具按钮：28×26 热区、字形居中、悬停与键盘焦点四态  -->
  <Style Selector="Button.qk-btn,ToggleButton.qk-btn">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!--  Ribbon 命令按钮：46px 紧凑命令条——横向 16px 图标 + 完整 API 名  -->
  <Style Selector="Button.rbn-cmd">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0,9" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>

  <!--  状态栏按钮：透明底、悬停加底色  -->
  <Style Selector="Button.st-btn">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.st-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>

  <!--  面板头部：标题 + 计数 + 右侧工具按钮  -->
  <Style Selector="TextBlock.panel-head">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.72" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--  导航树：组节点与叶子行  -->
  <Style Selector="ToggleButton.nav-group">
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="ToggleButton.nav-group:pointerover">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>
  <Style Selector="Button.nav-leaf">
    <Setter Property="Padding" Value="6,3,4,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.nav-leaf:pointerover">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>

  <!--  密度：紧凑档收窄 Ribbon 命令按钮（原型的 data-density=compact）  -->
  <Style Selector="Button.rbn-cmd.compact">
    <Setter Property="MinWidth" Value="60" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="4,4" />
  </Style>

  <!--  场景页步骤条：轨道式步骤，当前高亮、已完成打勾  -->
  <Style Selector="Button.scene-step">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.scene-step:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="Button.scene-step.active">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource StudioBorder}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no.done">
    <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no.done > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource StudioSurface}" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="18" /></Style>

  <Style Selector="ToggleButton.nav-group TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
  </Style>
  <Style Selector="ToggleButton.nav-group /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.nav-group:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.nav-group:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>
  <Style Selector="TextBlock.studio-title">
    <Setter Property="FontSize" Value="26" />
  </Style>
  <Style Selector="Button.demo-action, Button.studio-button, Button.b">
    <Setter Property="Theme" Value="{DynamicResource OutlineButton}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Button.rbn-cmd,Button.nav-leaf">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.rbn-cmd /template/ ContentPresenter#PART_ContentPresenter, Button.nav-leaf /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
  </Style>
  <Style Selector="Button.rbn-cmd:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav-leaf:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>
  <Style Selector="Button.rbn-cmd.selected /template/ ContentPresenter#PART_ContentPresenter, Button.nav-leaf.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="Button.rbn-cmd:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.nav-leaf:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
  </Style>
  <Style Selector="Button.rbn-cmd:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.nav-leaf:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorDisabledFill}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorDisabledText}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- 分类页签使用 Semi 线形模板，避免模板与内容重复留白。 -->
  <Style Selector="TabStrip#RibbonTabStrip TabStripItem">
    <Setter Property="Height" Value="42" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TabStrip#RibbonTabStrip TabStripItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <Style Selector="Button.rbn-cmd">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0,9" />
  </Style>
  <Style Selector="Button.rbn-cmd.compact"><Setter Property="Padding" Value="0,9,2,9" /></Style>
  <Style Selector="Button.rbn-cmd StackPanel.ribbon-content"><Setter Property="Orientation" Value="Horizontal" /></Style>
  <Style Selector="Button.nav-leaf"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FontSize" Value="12.5" /><Setter Property="MinHeight" Value="30" /></Style>
  <Style Selector="ToggleButton.nav-group"><Setter Property="FontSize" Value="11" /><Setter Property="MinHeight" Value="31" /></Style>
  <Style Selector="Button.demo-action"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" /></Style>
  <Style Selector="Border.studio-card"><Setter Property="CornerRadius" Value="10" /></Style>
  <Style Selector="TextBlock.studio-heading"><Setter Property="FontSize" Value="12" /></Style>
  <!-- 快捷入口比主命令轻，图标与点击热区分别控制。 -->
  <Style Selector="Button.ribbon-quick">
    <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
    <Setter Property="ToolTip.ShowDelay" Value="400" />
  </Style>
  <Style Selector="PathIcon.ribbon-quick-icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Button.ribbon-quick /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ribbon-quick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="Button.ribbon-quick:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="Button.ribbon-quick:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="PathIcon.nav-chevron">
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="PathIcon.nav-chevron.expanded"><Setter Property="RenderTransform" Value="rotate(90deg)" /></Style>
  <!-- 右侧快捷操作遵循原型的文字按钮，保持稳定图标尺寸与键盘焦点。 -->
  <Style Selector="Button.ribbon-action">
    <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
  </Style>
  <!-- Ribbon 使用整块选中底色；图标默认中性，悬停与选中显主色（对齐原型）。 -->
  <Style Selector="Button.rbn-cmd"><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="PathIcon.ribbon-icon"><Setter Property="Foreground" Value="{DynamicResource StudioMuted}" /></Style>
  <Style Selector="Button.rbn-cmd:pointerover PathIcon.ribbon-icon, Button.rbn-cmd.selected PathIcon.ribbon-icon">
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="PathIcon.ribbon-icon:disabled"><Setter Property="Foreground" Value="{DynamicResource SemiColorDisabledText}" /></Style>
  <!--  「视图」外壳命令的勾选态：对勾常驻占位（Opacity 槽位），面板可见时点亮  -->
  <Style Selector="PathIcon.shell-check"><Setter Property="Foreground" Value="{DynamicResource StudioMuted}" /></Style>
  <Style Selector="Button.rbn-cmd.shell.selected PathIcon.shell-check"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource StudioAccent}" /></Style>
  <Style Selector="Border.catalog-group"><Setter Property="BorderThickness" Value="0" /></Style>

  <!--  外观菜单弹层（原型 appearance-choices 同构）  -->
  <Style Selector="Border.appearance-choices">
    <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 12 36 0 #33000000" />
  </Style>
  <Style Selector="TextBlock.appearance-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <!--  语言弹出菜单（原型 language-menu 同构）：图标触发、列表选中打勾  -->
  <Style Selector="Border.language-menu">
    <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinWidth" Value="172" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #26000000" />
  </Style>
  <Style Selector="ListBox.language-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.language-list ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.language-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>
  <Style Selector="ListBox.language-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="ListBox.mode-chips">
    <Setter Property="Background" Value="{DynamicResource StudioBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.mode-chips ListBoxItem">
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <!--  Vex appearance-pill：密度/模式三态行，三等分扁平 pill，选中 = 强调软底 + 强调文字  -->
  <Style Selector="ListBox.appearance-pills">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,9,0,0" />
  </Style>
  <Style Selector="ListBox.appearance-pills ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.appearance-pills ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.appearance-pills ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>
  <Style Selector="ListBox.appearance-pills ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
  </Style>
  <Style Selector="ListBox.appearance-pills ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!--  Vex palette-card-on：选中环（外扩 1.5px 强调描边）与右缘 ✓  -->
  <Style Selector="Border.palette-ring">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="7.5" />
    <Setter Property="Margin" Value="-1.5" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="TextBlock.palette-check">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <!--  Vex palette-add-card：虚线描边新增卡（Button 无虚线边框，用 Rectangle 覆层）  -->
  <Style Selector="Button.palette-add-card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="shapes|Rectangle.palette-add-dash">
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="RadiusX" Value="8" />
    <Setter Property="RadiusY" Value="8" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="StrokeDashArray" Value="4,3" />
    <Setter Property="Stroke" Value="{DynamicResource StudioBorder}" />
  </Style>
  <Style Selector="Button.palette-add-card:pointerover shapes|Rectangle.palette-add-dash">
    <Setter Property="Stroke" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="Button.palette-add-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>
  <Style Selector="ToggleButton.qk-btn.appearance-btn">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ToggleButton.qk-btn.lang-btn">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.lang-chip">
    <Setter Property="Background" Value="{DynamicResource StudioSelected}" />
  </Style>
  <Style Selector="TextBlock.lang-chip-text">
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="ListBox.language-list ListBoxItem:selected Border.lang-chip">
    <Setter Property="Background" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="ListBox.language-list ListBoxItem:selected TextBlock.lang-chip-text">
    <Setter Property="Foreground" Value="{DynamicResource StudioOnPrimary}" />
  </Style>
  <Style Selector="Button.palette-card">
    <Setter Property="Background" Value="{DynamicResource StudioBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.14" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.palette-card:hover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="Border.palette-badge">
    <Setter Property="Background" Value="{DynamicResource StudioAccent}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,0,0,-4" />
  </Style>
  <Style Selector="Border.palette-badge TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.palette-tool">
    <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.appearance-add">
    <Setter Property="Background" Value="{DynamicResource StudioBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.appearance-add:hover">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
  </Style>
</Styles>
