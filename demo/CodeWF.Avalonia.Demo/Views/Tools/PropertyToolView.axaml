<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels"
             x:Class="CodeWF.Avalonia.Demo.Views.Tools.PropertyToolView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True" Background="{DynamicResource StudioSurface}">
  <!--  右侧 PropertyGrid 工具面板内容（面板本身即控件的自我演示）  -->
  <codewf:PropertyGrid NameColumnWidth="112" Items="{Binding ActivePropertyItems}"
                       ValueCommittedCommand="{Binding ActiveValueCommittedCommand}"
                       BrowseRequestedCommand="{Binding ActiveBrowseRequestedCommand}" />
</UserControl>
