<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels"
             x:Class="CodeWF.Avalonia.Demo.Views.Tools.LogToolView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True" Background="{DynamicResource StudioSurface}">
  <!--  底部日志工具面板内容（LogView 实时事件流）  -->
  <codewf:LogView Source="{Binding LogSource}" LogDirectory="{Binding LogFolder}"
                  MaxDisplayCount="500" FontSize="11" Padding="10,4" />
</UserControl>
