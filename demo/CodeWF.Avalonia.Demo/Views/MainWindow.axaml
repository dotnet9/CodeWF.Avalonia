<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
                     xmlns:shapes="using:Avalonia.Controls.Shapes"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:codewf="https://codewf.com"
                     xmlns:u="https://irihi.tech/ursa"
                     xmlns:dock="using:Dock.Avalonia.Controls"
                     xmlns:dockmodel="using:Dock.Model.ReactiveUI.Controls"
                     xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels"
                     xmlns:views="using:CodeWF.Avalonia.Demo.Views"
                     x:Class="CodeWF.Avalonia.Demo.Views.MainWindow"
                     x:DataType="vm:MainViewModel"
                     x:CompileBindings="True"
                     Title="CodeWF.Avalonia Demo"
                     Icon="/Assets/logo.ico"
                     Width="1440" Height="860"
                     MinWidth="1120" MinHeight="640"
                     Background="{DynamicResource StudioBackground}"
                     Foreground="{DynamicResource StudioText}"
                     TitleBarHeight="52" CaptionButtonWidth="34" FontSize="14" FontFamily="{DynamicResource DefaultFontFamily}">

  <!--  外壳：CodeWFWindow 无边框窗口，标题栏即自我演示  -->


  <!--  外壳快捷键：命令面板 / 深浅 / 语言（与设计原型 Ctrl+K、Ctrl+D、Ctrl+L 一致）  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding QuickSaveCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding ToggleCommandPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding ToggleDarkCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding ToggleCultureCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding EscapeShellCommand}" />
  </Window.KeyBindings>

  <codewf:CodeWFWindow.LeftContent>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Image Source="/Assets/logo.png" Width="28" Height="28" VerticalAlignment="Center" />
      <TextBlock Text="CodeWF.Avalonia" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock x:Name="VersionText" Text="Demo" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
      <TextBlock Text="INTERFACE STUDIO" FontFamily="Consolas" FontSize="10" LetterSpacing="1.5" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0" />
    </StackPanel>
  </codewf:CodeWFWindow.LeftContent>
  <codewf:CodeWFWindow.RightContent>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
      <!--  外观菜单（Vex ShellAppearanceMenuView 口径）：密度/模式 pill 行 + 配色卡网格（选中环 + 右缘 ✓ + 推荐角标 + 用户卡 ✎/×） + 虚线新增卡  -->
      <ToggleButton x:Name="AppearanceButton" Classes="qk-btn appearance-btn"
                    ToolTip.Tip="{codewf:I18n Demo.Shell.AppearanceMenu}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <PathIcon Width="15" Height="15" Data="{DynamicResource SemiIconColorPalette}" />
          <TextBlock Text="{codewf:I18n Demo.Shell.AppearanceMenu}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </ToggleButton>
      <Popup PlacementTarget="{Binding #AppearanceButton}" Placement="Bottom" VerticalOffset="8"
             IsLightDismissEnabled="True" IsEnabled="{Binding #AppearanceButton.IsChecked}" IsOpen="{Binding #AppearanceButton.IsChecked, Mode=TwoWay}">
        <Border Classes="appearance-choices" Width="430">
          <StackPanel>
            <TextBlock Classes="appearance-title" Text="{codewf:I18n Demo.Shell.Density}" Margin="0,4,0,0" />
            <ListBox Classes="appearance-pills" SelectedIndex="{Binding DensityIndex}">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBoxItem Content="{codewf:I18n Demo.Shell.DensityComfort}" />
              <ListBoxItem Content="{codewf:I18n Demo.Shell.DensityCompact}" />
            </ListBox>
            <TextBlock Classes="appearance-title" Text="{codewf:I18n Demo.Shell.GlobalSettings.ModeLabel}" />
            <ListBox Classes="appearance-pills" x:Name="ThemeModePills" SelectedIndex="{Binding ThemeModeIndex}" ItemsSource="{Binding ThemeModes}">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <TextBlock Classes="appearance-title" Text="{codewf:I18n Demo.Shell.PalettesTitle}" />
            <ScrollViewer MaxHeight="470" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Palettes}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppearanceOption">
                      <Panel Margin="0,0,6,6">
                        <Grid>
                          <Button Classes="palette-card" Click="OnPaletteCardClick" Tag="{Binding}">
                            <StackPanel Spacing="6" Margin="0,0,24,0">
                              <ItemsControl ItemsSource="{Binding SwatchDots}" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2" Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate><Ellipse Width="16" Height="16" Fill="{Binding}" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" LineHeight="19" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Note}" FontSize="10" LineHeight="14" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </StackPanel>
                          </Button>
                          <!--  选中环：外扩 1.5px 强调色描边（Vex palette-card-on）  -->
                          <Border Classes="palette-ring" IsVisible="{Binding IsSelected}" />
                          <TextBlock Classes="palette-check" Text="✓" IsVisible="{Binding IsSelected}" />
                          <Border Classes="palette-badge" IsVisible="{Binding IsRecommended}">
                            <TextBlock Text="{codewf:I18n Demo.Shell.Pick}" FontSize="9" FontWeight="SemiBold" Margin="4,1" />
                          </Border>
                          <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsVisible="{Binding IsUser}">
                            <Button Classes="qk-btn palette-tool" Content="✎" ToolTip.Tip="{codewf:I18n Demo.Shell.EditPalette}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditUserPaletteCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Classes="qk-btn palette-tool" Content="×" ToolTip.Tip="{codewf:I18n Demo.Shell.RemovePalette}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveUserPaletteCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!--  虚线新增卡（Vex palette-add-card）  -->
                <Button Classes="palette-add-card" Command="{Binding AddPaletteCommand}" Margin="0,6,6,0">
                  <Panel>
                    <shapes:Rectangle Classes="palette-add-dash" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                      <TextBlock Text="＋" FontSize="26" HorizontalAlignment="Center" />
                      <TextBlock Text="{codewf:I18n Demo.Shell.AddPalette}" FontSize="10" Opacity="0.72" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Panel>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Popup>
      <!--  语言入口（Vex studio-language 口径）："文ᴬ" 触发钮 + 徽标行菜单，选中行强调底 + 右缘 ✓  -->
      <ToggleButton x:Name="TitleBarLanguageButton" Classes="qk-btn lang-btn"
                    ToolTip.Tip="{codewf:I18n Demo.Shell.GlobalSettings.LanguageLabel}">
        <TextBlock Text="Aa" FontSize="12" />
      </ToggleButton>
      <Popup PlacementTarget="{Binding #TitleBarLanguageButton}" Placement="Bottom" VerticalOffset="8"
             IsLightDismissEnabled="True" IsEnabled="{Binding #TitleBarLanguageButton.IsChecked}" IsOpen="{Binding #TitleBarLanguageButton.IsChecked, Mode=TwoWay}">
        <Border Classes="language-menu" Width="236">
          <ListBox Classes="language-list" SelectedItem="{Binding SelectedCulture}" ItemsSource="{Binding Cultures}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CultureOption">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="26">
                  <Border Classes="lang-chip" Width="24" Height="24" CornerRadius="7">
                    <TextBlock Classes="lang-chip-text" Text="{Binding ShortName}" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="✓" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource StudioAccent}"
                             IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Popup>
      <!--  通知中心入口：徽标显示当前卡片数  -->
      <Button Classes="qk-btn" Command="{Binding NotifyDemoCommand}"
              ToolTip.Tip="{codewf:I18n Demo.Shell.NotifyDemo}">
        <Panel>
          <PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconBellStroked}" />
          <Border x:Name="NotificationCountBadge" MinWidth="16" Height="16" Padding="3,0" CornerRadius="8" Margin="0,-14,-12,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Background="{DynamicResource SemiColorDangerLight}"
                  IsVisible="{Binding HasNotifications}">
            <TextBlock x:Name="NotificationCountText" Text="{Binding NotificationCount}" FontSize="10" Foreground="{DynamicResource SemiColorDanger}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
      </Button>
    </StackPanel>
  </codewf:CodeWFWindow.RightContent>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!--  Ribbon 页签行：快捷工具栏 + 分类页签（双击页签折叠/展开命令区，不另设图钉按钮）  -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="42" Background="{DynamicResource StudioSurface}">
      <Border Grid.Column="0" x:Name="RibbonQuickAccess" VerticalAlignment="Center"
              BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,0,1,0" Padding="0,0,10,0" Margin="10,0,10,0">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="qk-btn ribbon-quick" ToolTip.Tip="{codewf:I18n Demo.Shell.QuickGuide}"
                  Command="{Binding QuickGuideCommand}">
            <PathIcon Classes="ribbon-quick-icon" Data="{DynamicResource SemiIconHelpCircleStroked}" />
          </Button>
          <Button Classes="qk-btn ribbon-quick" ToolTip.Tip="{codewf:I18n Demo.Shell.Reset}"
                  Command="{Binding QuickResetCommand}">
            <PathIcon Classes="ribbon-quick-icon" Data="{DynamicResource SemiIconRefresh}" />
          </Button>
          <Button Classes="qk-btn ribbon-quick" ToolTip.Tip="{codewf:I18n Demo.Shell.Palette}"
                  Command="{Binding CyclePaletteCommand}">
            <PathIcon Classes="ribbon-quick-icon" Data="{DynamicResource SemiIconColorPalette}" />
          </Button>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <TabStrip x:Name="RibbonTabStrip"
                Theme="{DynamicResource LineTabStrip}"
                ItemsSource="{Binding Groups}"
                SelectedItem="{Binding SelectedGroup}"
                DoubleTapped="OnRibbonTabStripDoubleTapped">
        <TabStrip.ItemTemplate>
          <DataTemplate x:DataType="vm:DemoGroupViewModel">
            <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
          </DataTemplate>
        </TabStrip.ItemTemplate>
      </TabStrip>
      </ScrollViewer>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,10,0" VerticalAlignment="Center">
        <Button Classes="ribbon-action" Command="{Binding ToggleCommandPaletteCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconSearchStroked}" />
            <TextBlock Text="{codewf:I18n Demo.Shell.Command}" />
            <TextBlock Text="Ctrl+K" Foreground="{DynamicResource StudioMuted}" FontSize="10" />
          </StackPanel>
        </Button>
        <Button Classes="ribbon-action" Command="{Binding ToggleDensityCommand}" ToolTip.Tip="{Binding DensityLabel}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconRowsStroked}" />
            <TextBlock Text="{codewf:I18n Demo.Shell.Density}" />
          </StackPanel>
        </Button>
        <Button Classes="ribbon-action" Command="{Binding QuickSaveCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconSaveStroked}" />
            <TextBlock Text="{codewf:I18n Demo.Shell.QuickSave}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!--  Ribbon 命令区：46px 紧凑单行命令条（16px 图标 + 完整 API 名），组间发丝竖线  -->
    <Border Grid.Row="1" IsVisible="{Binding RibbonExpanded}"
            Background="{DynamicResource StudioBackground}" ClipToBounds="True" Padding="12,7"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
            BorderThickness="0,1,0,1">
      <ScrollViewer x:Name="RibbonCommands" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding RibbonSections}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DemoRibbonSection">
              <Border BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DemoItemViewModel">
                        <Button Classes="rbn-cmd" Classes.selected="{Binding IsSelected}" Classes.shell="{Binding IsShellCommand}" Margin="0,0,2,0"
                                Height="{Binding $parent[ItemsControl].((vm:DemoRibbonSection)DataContext).CommandHeight}"
                                Classes.compact="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsCompactDensity}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenItemCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="{Binding DisplayTitle}">
                          <StackPanel Classes="ribbon-content" Spacing="7">
                            <PathIcon Classes="ribbon-icon" Width="16" Height="16" Data="{Binding RibbonIcon}" />
                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                            <PathIcon Classes="shell-check" Width="12" Height="12" Data="{StaticResource SemiIconTick}" Opacity="0" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- 文档整体承载演示与属性；导航、日志独立停靠，外壳浮层按需显示。 -->
    <Grid Grid.Row="2">
      <dock:DockControl Layout="{Binding Layout}" Margin="10" />
      <views:ShellOverlay DataContext="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>

    <!--  状态栏：运行状态 + 面板开关 + 版本信息  -->
    <Border Grid.Row="3" Padding="10,3"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="●" FontSize="10" Foreground="{DynamicResource SemiColorSuccess}" VerticalAlignment="Center" />
          <TextBlock Text="{codewf:I18n Demo.Shell.DemoShell}" FontWeight="SemiBold" FontSize="11.5"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="14,0,0,0"
                   Opacity="0.7" FontSize="11.5" VerticalAlignment="Center" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.Log}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="log" />
          <Border Width="1" Height="14" Margin="8,0"
                  Background="{DynamicResource TabControlSeparatorBorderBrush}" />
          <TextBlock Text="net10.0 · Avalonia 12.1.4" Opacity="0.6" FontSize="11"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</codewf:CodeWFWindow>
