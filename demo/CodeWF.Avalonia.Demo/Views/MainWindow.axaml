<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markdown="https://codewf.com"
        xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels"
        x:Class="CodeWF.Avalonia.Demo.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="CodeWF.Avalonia 演示" Width="1080" Height="720">
  <TabControl>
    <TabItem Header="Markdown">
      <markdown:MarkdownViewer Markdown="{Binding MarkdownSample}" />
    </TabItem>
    <TabItem Header="DataGrid">
      <DataGrid ItemsSource="{Binding People}" AutoGenerateColumns="False" CanUserSortColumns="True" Height="400">
        <DataGrid.Columns>
          <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="160" />
          <DataGridTextColumn Header="年龄" Binding="{Binding Age}" Width="100" />
          <DataGridTextColumn Header="城市" Binding="{Binding City}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </TabItem>
    <TabItem Header="日志">
      <StackPanel Margin="12" Spacing="8">
        <Button Content="写入三类日志" Command="{Binding WriteLogsCommand}" />
        <TextBlock Text="{Binding LogFolder}" Opacity="0.7" />
      </StackPanel>
    </TabItem>
    <TabItem Header="关于">
      <StackPanel Margin="12" Spacing="6">
        <TextBlock Text="CodeWF.Avalonia Demo" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Prism.DryIoc + Semi.Avalonia + ReactiveUI" />
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>
