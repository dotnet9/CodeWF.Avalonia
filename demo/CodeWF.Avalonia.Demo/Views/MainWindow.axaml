<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:codewf="https://codewf.com"
                     xmlns:dock="using:Dock.Avalonia.Controls"
                     xmlns:dockmodel="using:Dock.Model.ReactiveUI.Controls"
                     xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels"
                     xmlns:views="using:CodeWF.Avalonia.Demo.Views"
                     x:Class="CodeWF.Avalonia.Demo.Views.MainWindow"
                     x:DataType="vm:MainViewModel"
                     x:CompileBindings="True"
                     Title="CodeWF.Avalonia Demo"
                     Icon="/Assets/logo.ico"
                     Width="1440" Height="860"
                     MinWidth="1120" MinHeight="640">

  <!--  外壳：CodeWFWindow 无边框窗口，标题栏即自我演示  -->
  <Window.DataTemplates>
    <!--  Dock 12.1 内容承载：Tool / Document 的正文由类型匹配的 DataTemplate 呈现
          （IDockable.Context 只服务定位器与命令栏），这里把视图实例桥接到内容宿主。 -->
    <DataTemplate DataType="dockmodel:Tool" x:DataType="dockmodel:Tool">
      <ContentControl Content="{Binding Context}" />
    </DataTemplate>
    <DataTemplate DataType="dockmodel:Document" x:DataType="dockmodel:Document">
      <ContentControl Content="{Binding Context}" />
    </DataTemplate>
  </Window.DataTemplates>
  <codewf:CodeWFWindow.LeftContent>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Image Source="/Assets/logo.png" Width="18" Height="18" VerticalAlignment="Center" />
      <TextBlock Text="CodeWF.Avalonia" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock x:Name="VersionText" Text="Demo" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
    </StackPanel>
  </codewf:CodeWFWindow.LeftContent>
  <codewf:CodeWFWindow.RightContent>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
      <TextBlock Text="{codewf:I18n Demo.Shell.Palette}" VerticalAlignment="Center" FontSize="11.5" />
      <ComboBox MinWidth="88" Height="24" FontSize="11.5"
                ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}" />
      <ToggleButton Classes="qk-btn" Content="◐" IsChecked="{Binding IsDarkMode}"
                    ToolTip.Tip="{codewf:I18n Demo.Shell.Dark}" FontSize="13" />
      <ComboBox MinWidth="88" Height="24" FontSize="11.5"
                ItemsSource="{Binding Cultures}" SelectedItem="{Binding SelectedCulture}" />
    </StackPanel>
  </codewf:CodeWFWindow.RightContent>

  <!--  12.x Dock 内容承载：Tool/Document 的 Context 按类型匹配模板（挂在 DockControl 上确保解析命中）  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!--  Ribbon 页签行：快捷工具栏 + 7 页签（双击页签折叠/展开命令区，不另设图钉按钮）  -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
        <Button Classes="qk-btn" Content="◉" Margin="0,0,2,0"
                ToolTip.Tip="{codewf:I18n Demo.Shell.QuickGuide}"
                Command="{Binding QuickGuideCommand}" />
        <Button Classes="qk-btn" Content="▣" Margin="0,0,2,0"
                ToolTip.Tip="{codewf:I18n Demo.Shell.QuickSave}"
                Command="{Binding QuickSaveCommand}" />
        <Button Classes="qk-btn" Content="↺" Margin="0,0,2,0"
                ToolTip.Tip="{codewf:I18n Demo.Shell.Reset}"
                Command="{Binding QuickResetCommand}" />
        <Button Classes="qk-btn" Content="⚙"
                ToolTip.Tip="{codewf:I18n Demo.Shell.QuickSettings}"
                Command="{Binding QuickSettingsCommand}" />
      </StackPanel>

      <TabStrip Grid.Column="1" x:Name="RibbonTabStrip"
                Theme="{StaticResource TrapezoidShapedTabStrip}"
                ItemsSource="{Binding Groups}"
                SelectedItem="{Binding SelectedGroup}"
                DoubleTapped="OnRibbonTabStripDoubleTapped">
        <TabStrip.ItemTemplate>
          <DataTemplate x:DataType="vm:DemoGroupViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,4">
              <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </TabStrip.ItemTemplate>
      </TabStrip>
    </Grid>

    <!--  Ribbon 命令区：当前页签的演示命令（图标 + 名称），底部组名  -->
    <Border Grid.Row="1" IsVisible="{Binding RibbonExpanded}"
            ClipToBounds="True" Padding="12,8,12,5"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
            BorderThickness="0,1,0,1">
      <StackPanel Spacing="4">
        <ItemsControl ItemsSource="{Binding SelectedGroup.Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DemoItemViewModel">
              <Button Classes="rbn-cmd" Margin="0,0,8,6"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenItemCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" FontSize="11" MaxWidth="64"
                             HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding SelectedGroup.Title}" FontSize="10.5" Opacity="0.55" Margin="2,0,0,0" />
      </StackPanel>
    </Border>

    <!--  中央 Dock 工作区：导航树 / 文档区 / 属性 / 日志均为可停靠面板（Context 直接承载控件实例）  -->
    <dock:DockControl Grid.Row="2" Layout="{Binding Layout}" />

    <!--  状态栏：运行状态 + 面板开关 + 版本信息  -->
    <Border Grid.Row="3" Padding="10,3"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="●" FontSize="10" Foreground="#26a34a" VerticalAlignment="Center" />
          <TextBlock Text="{codewf:I18n Demo.Shell.DemoShell}" FontWeight="SemiBold" FontSize="11.5"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="14,0,0,0"
                   Opacity="0.7" FontSize="11.5" VerticalAlignment="Center" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.Navigation}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="nav" />
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.Properties}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="props" />
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.Log}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="log" />
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.Reset}"
                  Command="{Binding QuickResetCommand}" />
          <Border Width="1" Height="14" Margin="8,0"
                  Background="{DynamicResource TabControlSeparatorBorderBrush}" />
          <TextBlock Text="net10.0 · Avalonia 12.1.4" Opacity="0.6" FontSize="11"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>

  <Window.Styles>
    <Style Selector="Button.qk-btn,ToggleButton.qk-btn">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rbn-cmd">
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.st-btn">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>
</codewf:CodeWFWindow>
