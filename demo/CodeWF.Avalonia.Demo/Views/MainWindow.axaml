<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:codewf="https://codewf.com"
                     xmlns:dock="using:Dock.Avalonia.Controls"
                     xmlns:dockmodel="using:Dock.Model.ReactiveUI.Controls"
                     xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels"
                     xmlns:views="using:CodeWF.Avalonia.Demo.Views"
                     x:Class="CodeWF.Avalonia.Demo.Views.MainWindow"
                     x:DataType="vm:MainViewModel"
                     x:CompileBindings="True"
                     Title="CodeWF.Avalonia Demo"
                     Icon="/Assets/logo.ico"
                     Width="1440" Height="860"
                     MinWidth="1120" MinHeight="640"
                     Background="{DynamicResource StudioBackground}"
                     Foreground="{DynamicResource StudioText}"
                     TitleBarHeight="52" CaptionButtonWidth="34" FontSize="13" FontFamily="{DynamicResource DefaultFontFamily}">

  <!--  外壳：CodeWFWindow 无边框窗口，标题栏即自我演示  -->


  <!--  外壳快捷键：命令面板 / 深浅 / 语言（与设计原型 Ctrl+K、Ctrl+D、Ctrl+L 一致）  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding QuickSaveCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding ToggleCommandPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding ToggleDarkCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding ToggleCultureCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding EscapeShellCommand}" />
  </Window.KeyBindings>

  <codewf:CodeWFWindow.LeftContent>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Image Source="/Assets/logo.png" Width="28" Height="28" VerticalAlignment="Center" />
      <TextBlock Text="CodeWF.Avalonia" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock x:Name="VersionText" Text="Demo" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
      <TextBlock Text="INTERFACE STUDIO" FontFamily="Consolas" FontSize="10" LetterSpacing="1.5" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0" />
    </StackPanel>
  </codewf:CodeWFWindow.LeftContent>
  <codewf:CodeWFWindow.RightContent>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
      <ListBox Classes="studio-palettes" ItemsSource="{Binding Palettes}"
               SelectedItem="{Binding SelectedPalette}" ToolTip.Tip="{codewf:I18n Demo.Shell.Palette}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AppearanceOption">
            <Ellipse Width="13" Height="13" Fill="{Binding Swatch}" ToolTip.Tip="{Binding Title}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{codewf:I18n Demo.Shell.Palette}" VerticalAlignment="Center" FontSize="11.5" />
      <ComboBox MinWidth="96" Height="30" FontSize="11.5"
                ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AppearanceOption"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox MinWidth="100" Height="30" FontSize="11.5"
                x:Name="ThemeModeSelector" ItemsSource="{Binding ThemeModeOptions}" SelectedIndex="{Binding ThemeModeIndex}"
                HorizontalContentAlignment="Left" ToolTip.Tip="{codewf:I18n Demo.Shell.GlobalSettings.ModeLabel}">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ThemeModeOption"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox MinWidth="96" Height="30" FontSize="11.5"
                ItemsSource="{Binding Cultures}" SelectedItem="{Binding SelectedCulture}" />
      <!--  通知中心入口：徽标显示当前卡片数  -->
      <Button Classes="qk-btn" Command="{Binding NotifyDemoCommand}"
              ToolTip.Tip="{codewf:I18n Demo.Shell.NotifyDemo}">
        <Panel>
          <PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconBellStroked}" />
          <Border Width="14" Height="14" CornerRadius="7" Margin="0,-14,-12,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Background="{DynamicResource SemiColorDanger}"
                  IsVisible="{Binding HasNotifications}">
            <TextBlock Text="{Binding NotificationCount}" FontSize="8.5" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
      </Button>
    </StackPanel>
  </codewf:CodeWFWindow.RightContent>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!--  Ribbon 页签行：快捷工具栏 + 分类页签（双击页签折叠/展开命令区，不另设图钉按钮）  -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="42" Background="{DynamicResource StudioSurface}">
      <Border Grid.Column="0" x:Name="RibbonQuickAccess" VerticalAlignment="Center"
              BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,0,1,0" Padding="0,0,10,0" Margin="10,0,10,0">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="qk-btn ribbon-quick" ToolTip.Tip="{codewf:I18n Demo.Shell.QuickGuide}"
                  Command="{Binding QuickGuideCommand}">
            <PathIcon Classes="ribbon-quick-icon" Data="{DynamicResource SemiIconHelpCircleStroked}" />
          </Button>
          <Button Classes="qk-btn ribbon-quick" ToolTip.Tip="{codewf:I18n Demo.Shell.Reset}"
                  Command="{Binding QuickResetCommand}">
            <PathIcon Classes="ribbon-quick-icon" Data="{DynamicResource SemiIconRefresh}" />
          </Button>
          <Button Classes="qk-btn ribbon-quick" ToolTip.Tip="{codewf:I18n Demo.Shell.Palette}"
                  Command="{Binding CyclePaletteCommand}">
            <PathIcon Classes="ribbon-quick-icon" Data="{DynamicResource SemiIconColorPalette}" />
          </Button>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <TabStrip x:Name="RibbonTabStrip"
                Theme="{DynamicResource LineTabStrip}"
                ItemsSource="{Binding Groups}"
                SelectedItem="{Binding SelectedGroup}"
                DoubleTapped="OnRibbonTabStripDoubleTapped">
        <TabStrip.ItemTemplate>
          <DataTemplate x:DataType="vm:DemoGroupViewModel">
            <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
          </DataTemplate>
        </TabStrip.ItemTemplate>
      </TabStrip>
      </ScrollViewer>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,10,0" VerticalAlignment="Center">
        <Button Classes="ribbon-action" Command="{Binding ToggleCommandPaletteCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconSearchStroked}" />
            <TextBlock Text="{codewf:I18n Demo.Shell.Command}" />
            <TextBlock Text="Ctrl+K" Foreground="{DynamicResource StudioMuted}" FontSize="10" />
          </StackPanel>
        </Button>
        <Button Classes="ribbon-action" Command="{Binding ToggleDensityCommand}" ToolTip.Tip="{Binding DensityLabel}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconRowsStroked}" />
            <TextBlock Text="{codewf:I18n Demo.Shell.Density}" />
          </StackPanel>
        </Button>
        <Button Classes="ribbon-action" Command="{Binding QuickSaveCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconSaveStroked}" />
            <TextBlock Text="{codewf:I18n Demo.Shell.QuickSave}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!--  Ribbon 命令区：当前页签的演示命令（图标 + 名称），底部组名；按功能分组，密集命令使用双行  -->
    <Border Grid.Row="1" IsVisible="{Binding RibbonExpanded}"
            Background="{DynamicResource StudioBackground}" ClipToBounds="True" Padding="12,4,12,2"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
            BorderThickness="0,1,0,1">
      <ScrollViewer x:Name="RibbonCommands" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding RibbonSections}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DemoRibbonSection">
              <Border BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
                <StackPanel Spacing="2">
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Vertical" Height="80" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DemoItemViewModel">
                        <Button Classes="rbn-cmd" Classes.selected="{Binding IsSelected}" Margin="0,0,4,0"
                                Classes.small="{Binding $parent[ItemsControl].((vm:DemoRibbonSection)DataContext).UseSmallCommands}"
                                Height="{Binding $parent[ItemsControl].((vm:DemoRibbonSection)DataContext).CommandHeight}"
                                Classes.compact="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsCompactDensity}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenItemCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="{Binding DisplayTitle}">
                          <StackPanel Classes="ribbon-content" Spacing="5">
                            <PathIcon Classes="ribbon-icon" Width="32" Height="32" Data="{Binding RibbonIcon}" />
                            <TextBlock Text="{Binding DisplayTitle}" FontSize="11" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" TextAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Title}" FontSize="10" Foreground="{DynamicResource StudioMuted}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- 文档整体承载演示与属性；导航、日志独立停靠，外壳浮层按需显示。 -->
    <Grid Grid.Row="2">
      <dock:DockControl Layout="{Binding Layout}" Margin="10" />
      <views:ShellOverlay DataContext="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>

    <!--  状态栏：运行状态 + 面板开关 + 版本信息  -->
    <Border Grid.Row="3" Padding="10,3"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="●" FontSize="10" Foreground="#26a34a" VerticalAlignment="Center" />
          <TextBlock Text="{codewf:I18n Demo.Shell.DemoShell}" FontWeight="SemiBold" FontSize="11.5"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="14,0,0,0"
                   Opacity="0.7" FontSize="11.5" VerticalAlignment="Center" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.Navigation}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="nav" />
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.Properties}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="props" />
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.Log}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="log" />
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.DensityLabel}"
                  Command="{Binding ToggleDensityCommand}" />
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.Command}"
                  Command="{Binding ToggleCommandPaletteCommand}" />
          <Button Classes="st-btn" Content="{codewf:I18n Demo.Shell.Reset}"
                  Command="{Binding QuickResetCommand}" />
          <Border Width="1" Height="14" Margin="8,0"
                  Background="{DynamicResource TabControlSeparatorBorderBrush}" />
          <TextBlock Text="net10.0 · Avalonia 12.1.4" Opacity="0.6" FontSize="11"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</codewf:CodeWFWindow>
