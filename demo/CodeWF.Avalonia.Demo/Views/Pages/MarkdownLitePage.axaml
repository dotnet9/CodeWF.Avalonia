<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:pages="using:CodeWF.Avalonia.Demo.Views.Pages"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.MarkdownLitePage"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" Margin="12,10">

    <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="Markdown Lite" FontWeight="Bold" />
        <TextBlock Text="{codewf:I18n Demo.Text.MarkdownLitePage.View001}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
      </StackPanel>
    </Border>

    <codewf:MarkdownViewer Grid.Row="1" x:Name="Viewer" Margin="0,10,0,0"
                           TypographyTheme="Basic"
                           Markdown="{x:Static pages:MarkdownLitePage.SampleMarkdown}" />
  </Grid>
</UserControl>
