<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.MarkdownEditorPage"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12,10">

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
      <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.MarkdownEditor.View.Bold}" Click="OnBold" />
      <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.MarkdownEditor.View.Italic}" Click="OnItalic" />
      <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.MarkdownEditor.View.InlineCode}" Click="OnInlineCode" />
      <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.MarkdownEditor.View.Heading2}" Click="OnHeading" />
      <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.MarkdownEditor.View.Table}" Click="OnTable" />
      <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.MarkdownEditor.View.TaskList}" Click="OnTaskList" />
      <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.MarkdownEditor.View.CodeBlock}" Click="OnCodeFence" />
      <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.MarkdownEditor.View.Quote}" Click="OnQuote" />
    </StackPanel>

    <Border Grid.Row="2" x:Name="EditorHost" Margin="0,8,0,0"
            BorderThickness="1" CornerRadius="6"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
            ClipToBounds="True" />

    <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,8,0,0" FontSize="11" Opacity="0.7" />
  </Grid>
</UserControl>
