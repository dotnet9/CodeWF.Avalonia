<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:codewf="https://codewf.com" xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels" xmlns:pages="using:CodeWF.Avalonia.Demo.Views.Pages"
 x:Class="CodeWF.Avalonia.Demo.Views.Pages.WelcomePage" x:DataType="vm:WelcomeViewModel" x:CompileBindings="True" Classes="studio-page">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="20,16" Spacing="14" MaxWidth="1180">
   <StackPanel Spacing="8">
    <TextBlock Text="{codewf:I18n Demo.Catalog.Title}" FontSize="18" FontWeight="SemiBold" />
    <ItemsControl ItemsSource="{Binding CatalogGroups}">
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:DemoGroupViewModel">
       <Border Classes="studio-card catalog-group" Margin="0,4" Padding="14,10">
        <StackPanel Spacing="8">
         <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource StudioAccent}" />
         <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
           <DataTemplate x:DataType="vm:DemoItemViewModel">
            <Button Classes="demo-action" Content="{Binding Title}" Command="{Binding $parent[UserControl].((vm:WelcomeViewModel)DataContext).NavigateCommand}" CommandParameter="{Binding TitleKey}" Margin="0,0,6,6" Padding="10,5" />
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
   <Expander Header="{codewf:I18n Demo.Catalog.Examples}" IsExpanded="{Binding ExperimentsExpanded}">
    <StackPanel Spacing="16">
   <Border Classes="studio-card">
    <StackPanel Spacing="10">
     <TextBlock Text="{codewf:I18n Demo.Studio.Lab}" Classes="studio-kicker" />
     <TabControl Classes="studio-lab" SelectedIndex="{Binding LabIndex}">
<TabItem Header="{codewf:I18n Demo.Studio.Markdown}">
       <Grid RowDefinitions="Auto,170,Auto" ColumnDefinitions="*,*">
        <TextBlock Text="{codewf:I18n Demo.Studio.Source}" Classes="studio-kicker" Margin="0,0,0,8" />
        <TextBlock Grid.Column="1" Text="{codewf:I18n Demo.Studio.Preview}" Classes="studio-kicker" Margin="12,0,0,8" />
        <codewf:MarkdownEditorView Grid.Row="1" Text="{Binding Markdown, Mode=TwoWay}" EditorFontSize="11"
                                   ShowLineNumbers="False" EditorPadding="10,8" EditorLineHeight="20"
                                   EditorBackgroundKey="StudioBackground" EditorForegroundKey="StudioText"
                                   AccentKey="StudioAccent" CodeKey="StudioAccent" QuoteKey="StudioMuted"
                                   LinkKey="StudioSecondary" SeparatorKey="StudioBorder" />
        <Border Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" CornerRadius="8" Background="{DynamicResource StudioRaised}">
         <codewf:MarkdownViewer Markdown="{Binding Markdown}" Margin="13,10" Classes="studio-preview"
                                ParagraphFontSize="12" ParagraphLineHeight="22" Heading1FontSize="17"
                                Heading2FontSize="16" Heading3FontSize="15" HeadingMargin="0,0,0,6"
                                ParagraphMargin="0,0,0,6" BlockSpacing="4" DocumentBottomPadding="8"
                                InlineCodeBackgroundBrush="{DynamicResource StudioRaised}" Foreground="{DynamicResource StudioText}" />
        </Border>
        <Button Classes="demo-action" Grid.Row="2" Grid.ColumnSpan="2" Content="{codewf:I18n Demo.Studio.Open}" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.MarkdownViewer" Margin="0,10,0,0" HorizontalAlignment="Left" />
       </Grid>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Studio.Sort}">
       <StackPanel Spacing="8">
        <TextBlock Text="{codewf:I18n Demo.Studio.SortHint}" Classes="studio-muted" />
        <DataGrid Height="160" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" codewf:DataGridEnhancement.UseDefaults="True">
         <DataGrid.Columns><DataGridTextColumn Header="{codewf:I18n Demo.Studio.SortName}" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="{codewf:I18n Demo.Studio.SortModule}" Binding="{Binding Module}" Width="150" /><DataGridTextColumn Header="{codewf:I18n Demo.Studio.SortStatus}" Binding="{Binding Status}" Width="*" /></DataGrid.Columns>
        </DataGrid>
        <Button Classes="demo-action" Content="{codewf:I18n Demo.Studio.Open}" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.DataGrid" HorizontalAlignment="Left" />
       </StackPanel>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Studio.Dock}">
       <StackPanel Spacing="8">
        <TextBlock Text="{codewf:I18n Demo.Studio.PanelHint}" Classes="studio-muted" />
        <pages:DockPage Height="220" />
        <StackPanel Orientation="Horizontal" Spacing="8">
         <Button Classes="demo-action" Content="{codewf:I18n Demo.Studio.Nav}" Command="{Binding TogglePanelCommand}" CommandParameter="nav" />
         <Button Classes="demo-action" Content="{codewf:I18n Demo.Studio.Props}" Command="{Binding TogglePanelCommand}" CommandParameter="props" />
         <Button Classes="demo-action" Content="{codewf:I18n Demo.Studio.Logs}" Command="{Binding TogglePanelCommand}" CommandParameter="log" />
         <Button Classes="demo-action" Content="{codewf:I18n Demo.Studio.Open}" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.Dock" />
        </StackPanel>
       </StackPanel>
      </TabItem>
     </TabControl>
    </StackPanel>
   </Border>

   <Border Classes="studio-card">
    <Grid ColumnDefinitions="*,Auto">
     <StackPanel Spacing="8"><TextBlock Text="{codewf:I18n Demo.Studio.QuickStart}" FontWeight="SemiBold" /><SelectableTextBlock Text="{Binding InstallCommand}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding CopyStatus}" Classes="studio-muted" /></StackPanel>
     <Button Classes="demo-action" Grid.Column="1" Content="{codewf:I18n Demo.Studio.Copy}" Command="{Binding CopyInstallCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
    </Grid>
   </Border>
    </StackPanel>
   </Expander>
  </StackPanel>
 </ScrollViewer>
</UserControl>
