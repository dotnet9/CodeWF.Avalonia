<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:codewf="https://codewf.com" xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels" xmlns:pages="using:CodeWF.Avalonia.Demo.Views.Pages"
 x:Class="CodeWF.Avalonia.Demo.Views.Pages.WelcomePage" x:DataType="vm:WelcomeViewModel" x:CompileBindings="True" Classes="studio-page">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24,20" Spacing="18" MaxWidth="1180">
   <Border Classes="studio-hero">
    <Grid ColumnDefinitions="*,130">
     <StackPanel Spacing="9">
      <TextBlock Text="AVALONIA COMPONENT STUDIO" Classes="studio-kicker" />
      <TextBlock Text="CodeWF.Avalonia" Classes="studio-title" />
      <TextBlock Text="{codewf:I18n Demo.Studio.Tagline}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{codewf:I18n Demo.Studio.Intro}" Classes="studio-muted" MaxWidth="620" HorizontalAlignment="Left" />
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
       <TextBlock Text="{codewf:I18n Demo.Studio.PackageCount}" Classes="studio-kicker" />
       <TextBlock Text=".NET 10" Classes="studio-muted" /><TextBlock Text="Windows / macOS / Linux" Classes="studio-muted" />
      </StackPanel>
     </StackPanel>
     <Panel Grid.Column="1" IsHitTestVisible="False">
      <Border Classes="studio-orbit" Width="126" Height="126" />
      <Border Classes="studio-orbit" Width="94" Height="94" RenderTransform="rotate(25deg)" />
      <Border Width="66" Height="66" CornerRadius="20" Background="{DynamicResource StudioGradient}">
       <TextBlock Text="UI" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
     </Panel>
    </Grid>
   </Border>
   <Border Classes="studio-card">
    <StackPanel Spacing="10">
     <TextBlock Text="{codewf:I18n Demo.Studio.Lab}" Classes="studio-kicker" />
     <TabControl Classes="studio-lab" SelectedIndex="{Binding LabIndex}">
<TabItem Header="{codewf:I18n Demo.Studio.Markdown}">
       <Grid RowDefinitions="Auto,170,Auto" ColumnDefinitions="*,*">
        <TextBlock Text="{codewf:I18n Demo.Studio.Source}" Classes="studio-kicker" Margin="0,0,0,8" />
        <TextBlock Grid.Column="1" Text="{codewf:I18n Demo.Studio.Preview}" Classes="studio-kicker" Margin="12,0,0,8" />
        <TextBox Grid.Row="1" Text="{Binding Markdown, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top" />
        <Border Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" CornerRadius="8" Background="{DynamicResource StudioRaised}">
         <codewf:MarkdownViewer Markdown="{Binding Markdown}" Margin="8" />
        </Border>
        <Button Grid.Row="2" Grid.ColumnSpan="2" Content="{codewf:I18n Demo.Studio.Open}" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.MarkdownFlow" Margin="0,10,0,0" HorizontalAlignment="Left" />
       </Grid>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Studio.Sort}">
       <StackPanel Spacing="8">
        <TextBlock Text="{codewf:I18n Demo.Studio.SortHint}" Classes="studio-muted" />
        <DataGrid Height="160" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" codewf:DataGridEnhancement.UseDefaults="True">
         <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="100" /><DataGridTextColumn Header="City" Binding="{Binding City}" Width="*" /></DataGrid.Columns>
        </DataGrid>
        <Button Content="{codewf:I18n Demo.Studio.Open}" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.DataGrid" HorizontalAlignment="Left" />
       </StackPanel>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Studio.Dock}">
       <StackPanel Spacing="8">
        <TextBlock Text="{codewf:I18n Demo.Studio.PanelHint}" Classes="studio-muted" />
        <pages:DockPage Height="220" />
        <StackPanel Orientation="Horizontal" Spacing="8">
         <Button Content="{codewf:I18n Demo.Studio.Nav}" Command="{Binding TogglePanelCommand}" CommandParameter="nav" />
         <Button Content="{codewf:I18n Demo.Studio.Props}" Command="{Binding TogglePanelCommand}" CommandParameter="props" />
         <Button Content="{codewf:I18n Demo.Studio.Logs}" Command="{Binding TogglePanelCommand}" CommandParameter="log" />
         <Button Content="{codewf:I18n Demo.Studio.Open}" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.Dock" />
        </StackPanel>
       </StackPanel>
      </TabItem>
     </TabControl>
    </StackPanel>
   </Border>
   <TextBlock Text="{codewf:I18n Demo.Studio.Explore}" Classes="studio-kicker" />
   <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="-4"><Panel Grid.Row="0" Grid.Column="0"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.MarkdownViewer">
      <StackPanel Spacing="6"><TextBlock Text="M↓" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="Markdown" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View001}" Classes="studio-muted" /></StackPanel></Button></Panel>
<Panel Grid.Row="0" Grid.Column="1"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.DataGrid">
      <StackPanel Spacing="6"><TextBlock Text="▤" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="DataGrid" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View002}" Classes="studio-muted" /></StackPanel></Button></Panel>
<Panel Grid.Row="0" Grid.Column="2"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.Dock">
      <StackPanel Spacing="6"><TextBlock Text="▥" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="Dock" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View003}" Classes="studio-muted" /></StackPanel></Button></Panel>
<Panel Grid.Row="1" Grid.Column="0"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.SearchListBox">
      <StackPanel Spacing="6"><TextBlock Text="⌘" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="Controls" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View004}" Classes="studio-muted" /></StackPanel></Button></Panel>
<Panel Grid.Row="1" Grid.Column="1"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.PropertyGrid">
      <StackPanel Spacing="6"><TextBlock Text="≡" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="PropertyGrid" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View005}" Classes="studio-muted" /></StackPanel></Button></Panel>
<Panel Grid.Row="1" Grid.Column="2"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.Log">
      <StackPanel Spacing="6"><TextBlock Text="↔" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="Log &amp; Lang" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View006}" Classes="studio-muted" /></StackPanel></Button></Panel></Grid>
   <Border Classes="studio-card">
    <Grid ColumnDefinitions="*,Auto">
     <StackPanel Spacing="8"><TextBlock Text="{codewf:I18n Demo.Studio.QuickStart}" FontWeight="SemiBold" /><SelectableTextBlock Text="{Binding InstallCommand}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding CopyStatus}" Classes="studio-muted" /></StackPanel>
     <Button Grid.Column="1" Content="{codewf:I18n Demo.Studio.Copy}" Command="{Binding CopyInstallCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
    </Grid>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
