<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages" xmlns:md="using:CodeWF.Avalonia.Markdown"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.MarkdownExportPage"
             x:DataType="vm:MarkdownExportPageViewModel" x:CompileBindings="True">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12,10">

    <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <TextBlock Text="{codewf:I18n Demo.Text.MarkdownExportPage.View001}"
                 TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
      <Button Content="{codewf:I18n Demo.Text.MarkdownExportPage.View002}" Command="{Binding ExportCommand}" CommandParameter="{x:Static md:ExportKind.Png}" />
      <Button Content="{codewf:I18n Demo.Text.MarkdownExportPage.View003}" Command="{Binding ExportCommand}" CommandParameter="{x:Static md:ExportKind.Pdf}" />
      <Button Content="{codewf:I18n Demo.Text.MarkdownExportPage.View004}" Command="{Binding ExportCommand}" CommandParameter="{x:Static md:ExportKind.Word}" />
      <Button Content="{codewf:I18n Demo.Text.MarkdownExportPage.View005}" Command="{Binding ExportCommand}" CommandParameter="{x:Static md:ExportKind.Html}" />
      <Button Content="{codewf:I18n Demo.Text.MarkdownExportPage.View006}" Command="{Binding CopyCommand}" />
    </StackPanel>

    <TextBox Grid.Row="2" x:Name="SourceBox" Margin="0,8,0,0"
             AcceptsReturn="True" TextWrapping="Wrap"
             Text="{Binding Markdown, Mode=TwoWay}"
             FontFamily="Consolas, Microsoft YaHei UI" FontSize="13" />

    <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,8,0,0" FontSize="11" Opacity="0.75" />
  </Grid>
</UserControl>
