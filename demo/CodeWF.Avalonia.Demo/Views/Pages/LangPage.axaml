<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.LangPage"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages"
             x:DataType="vm:LangPageViewModel"
             x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Margin="12,10" Spacing="12" MaxWidth="860" HorizontalAlignment="Left">

      <Border Padding="10" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
        <TextBlock Text="{codewf:I18n Demo.Content.Lang.View.I18nManagerUsesAPluggableLocalizationBackendTheDemo}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.Lang.View.SwitchToEnglish}" Command="{Binding SwitchCultureCommand}" CommandParameter="en-US" />
        <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.Lang.View.SwitchToSimplifiedChinese}" Command="{Binding SwitchCultureCommand}" CommandParameter="zh-CN" />
        <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.Lang.View.UseSystemCulture}" Command="{Binding SwitchCultureCommand}" CommandParameter="system" />
      </StackPanel>

      <Border Padding="12" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="{codewf:I18n Demo.Lang.LiveSamplesTitle}" FontWeight="Bold" />
          <TextBlock Text="{codewf:I18n Demo.Lang.SampleGreeting}" FontSize="16" />
          <TextBlock Text="{codewf:I18n Demo.Lang.SampleFarewell}" FontSize="16" />
          <TextBlock Text="{codewf:I18n Demo.Lang.SampleFormat}" FontSize="16" />
        </StackPanel>
      </Border>

      <Border Padding="12" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="{codewf:I18n Demo.Lang.StateTitle}" FontWeight="Bold" />
          <TextBlock Text="{Binding State}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
          <TextBlock Text="CodeWF.Avalonia.Lang.Generator" FontFamily="Consolas" FontSize="11" />
          <SelectableTextBlock Text="{Binding GeneratedKey}" FontFamily="Consolas" FontSize="11" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
