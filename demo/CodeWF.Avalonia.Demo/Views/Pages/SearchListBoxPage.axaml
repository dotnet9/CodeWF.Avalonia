<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.SearchListBoxPage"
             x:DataType="vm:SearchListBoxPageViewModel"
             x:CompileBindings="True">
  <Grid ColumnDefinitions="2*,*" Margin="12,10">

    <codewf:SearchListBox Grid.Column="0" x:Name="List"
                          ItemsSource="{Binding Items}" />

    <Border Grid.Column="1" Margin="12,0,0,0"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
            BorderThickness="1,0,0,0" Padding="12,0,0,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="{codewf:I18n Demo.Content.SearchListBox.View.InteractionLog}" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" x:Name="CountText" FontSize="11" Opacity="0.75" Margin="0,0,0,6" />
        <TextBlock Grid.Row="2" Text="{codewf:I18n Demo.Content.SearchListBox.View.Hint}" FontWeight="Bold" Margin="0,4,0,2" />
        <TextBlock Grid.Row="3" Text="{codewf:I18n Demo.Content.SearchListBox.View.SearchHasA400msDebounceUseCtrlShift}"
                   TextWrapping="Wrap" FontSize="11" Opacity="0.65" Margin="0,0,0,6" />
        <ListBox Grid.Row="4" ItemsSource="{Binding EventLog}" FontSize="11" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
