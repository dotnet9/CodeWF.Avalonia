<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.DockPage"
             x:DataType="vm:DockPageViewModel"
             x:CompileBindings="True">

  <Grid RowDefinitions="Auto,*" Margin="12,10">
    <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1" Margin="0,0,0,8"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <TextBlock Text="Dock 工作区：Dock.Avalonia 布局引擎 + CodeWF DockSemiTheme（Semi 皮肤与中英文本地化）。可拖拽停靠、浮动、最大化；文档内容经 DocumentTemplate 以 MarkdownViewer 呈现。"
                 TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
    </Border>
    <dock:DockControl Grid.Row="1" Layout="{Binding Layout}" />
  </Grid>
</UserControl>
