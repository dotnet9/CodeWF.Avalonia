<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.StatusComponentsPage"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages"
             x:DataType="vm:StatusComponentsPageViewModel"
             x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Margin="12,10" Spacing="12" MaxWidth="900">

      <Border Padding="10" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
        <TextBlock Text="{codewf:I18n Demo.Text.StatusComponentsPage.View001}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
      </Border>

      <TextBlock Text="StatusBadge" FontWeight="Bold" />
      <WrapPanel>
        <codewf:StatusBadge LeftText="Debug" RightText="{codewf:I18n Demo.Text.StatusComponentsPage.View002}" Margin="0,0,8,8" />
        <codewf:StatusBadge LeftText="Info" RightText="{codewf:I18n Demo.Text.StatusComponentsPage.View003}" Margin="0,0,8,8" />
        <codewf:StatusBadge LeftText="Warn" RightText="{codewf:I18n Demo.Text.StatusComponentsPage.View004}" Margin="0,0,8,8" />
        <codewf:StatusBadge LeftText="Error" RightText="{codewf:I18n Demo.Text.StatusComponentsPage.View005}" Margin="0,0,8,8" />
        <codewf:StatusBadge LeftText="Fatal" RightText="{codewf:I18n Demo.Text.StatusComponentsPage.View006}" Margin="0,0,8,8" />
      </WrapPanel>

      <TextBlock Text="StatusCard" FontWeight="Bold" />
      <WrapPanel>
        <codewf:StatusCard Kind="Debug" TopText="DEBUG" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View007}" Margin="0,0,8,8" />
        <codewf:StatusCard Kind="Info" TopText="INFO" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View008}" Margin="0,0,8,8" />
        <codewf:StatusCard Kind="Warn" TopText="WARN" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View009}" Margin="0,0,8,8" />
        <codewf:StatusCard Kind="Error" TopText="ERROR" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View010}" Margin="0,0,8,8" />
        <codewf:StatusCard Kind="Fatal" TopText="FATAL" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View011}" Margin="0,0,8,8" />
      </WrapPanel>

      <TextBlock Text="{codewf:I18n Demo.Text.StatusComponentsPage.View012}" FontWeight="Bold" />
      <codewf:StatusCard x:Name="DrivenCard" Kind="{Binding Kind}"
                         TopText="DRIVEN" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View013}" IconWidth="{Binding IconWidth}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
