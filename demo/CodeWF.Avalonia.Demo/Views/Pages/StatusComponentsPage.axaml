<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.StatusComponentsPage"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages"
             x:DataType="vm:StatusComponentsPageViewModel"
             x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Margin="12,10" Spacing="12" MaxWidth="900">

      <TextBlock IsVisible="{Binding ShowBadges}" Text="StatusBadge" FontWeight="Bold" />
      <WrapPanel IsVisible="{Binding ShowBadges}">
        <codewf:StatusBadge Classes="Debug" LeftText="Debug" RightText="{codewf:I18n Demo.Content.StatusComponents.View.Debug}" Margin="0,0,8,8" />
        <codewf:StatusBadge Classes="Info" LeftText="Info" RightText="{codewf:I18n Demo.Content.StatusComponents.View.Information}" Margin="0,0,8,8" />
        <codewf:StatusBadge Classes="Warn" LeftText="Warn" RightText="{codewf:I18n Demo.Content.StatusComponents.View.Warning}" Margin="0,0,8,8" />
        <codewf:StatusBadge Classes="Error" LeftText="Error" RightText="{codewf:I18n Demo.Content.StatusComponents.View.Error}" Margin="0,0,8,8" />
        <codewf:StatusBadge Classes="Fatal" LeftText="Fatal" RightText="{codewf:I18n Demo.Content.StatusComponents.View.Critical}" Margin="0,0,8,8" />
      </WrapPanel>

      <TextBlock IsVisible="{Binding ShowCards}" Text="StatusCard" FontWeight="Bold" />
      <WrapPanel IsVisible="{Binding ShowCards}">
        <codewf:StatusCard Width="180" Height="80" Kind="Debug" TopText="DEBUG" BottomText="{codewf:I18n Demo.Content.StatusComponents.View.Debugging}" Margin="0,0,8,8" />
        <codewf:StatusCard Width="180" Height="80" Kind="Info" TopText="INFO" BottomText="{codewf:I18n Demo.Content.StatusComponents.View.ServiceReady}" Margin="0,0,8,8" />
        <codewf:StatusCard Width="180" Height="80" Kind="Warn" TopText="WARN" BottomText="{codewf:I18n Demo.Content.StatusComponents.View.DiskSpaceLow}" Margin="0,0,8,8" />
        <codewf:StatusCard Width="180" Height="80" Kind="Error" TopText="ERROR" BottomText="{codewf:I18n Demo.Content.StatusComponents.View.ServiceTimeout}" Margin="0,0,8,8" />
        <codewf:StatusCard Width="180" Height="80" Kind="Fatal" TopText="FATAL" BottomText="{codewf:I18n Demo.Content.StatusComponents.View.DatabaseOffline}" Margin="0,0,8,8" />
      </WrapPanel>

      <TextBlock Text="{codewf:I18n Demo.Content.StatusComponents.View.DrivenByPropertyPanel}" FontWeight="Bold" />
      <codewf:StatusBadge IsVisible="{Binding ShowBadges}" LeftText="{Binding BadgeKind}" RightText="{Binding BadgeText}"
                          Classes.Debug="{Binding BadgeDebug}" Classes.Info="{Binding BadgeInfo}" Classes.Warn="{Binding BadgeWarn}"
                          Classes.Error="{Binding BadgeError}" Classes.Fatal="{Binding BadgeFatal}" HorizontalAlignment="Left" />
      <codewf:StatusCard IsVisible="{Binding ShowCards}" x:Name="DrivenCard" Kind="{Binding Kind}"
                         TopText="DRIVEN" BottomText="{codewf:I18n Demo.Content.StatusComponents.View.ChangeTheStatusAndIconWidthInThe}" IconWidth="{Binding IconWidth}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
