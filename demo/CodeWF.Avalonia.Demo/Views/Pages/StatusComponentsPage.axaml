<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.StatusComponentsPage"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages"
             x:DataType="vm:StatusComponentsPageViewModel"
             x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Margin="12,10" Spacing="12" MaxWidth="900">

      <Border IsVisible="{Binding ShowBadges}" Padding="10" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
        <TextBlock Text="{codewf:I18n Demo.Api.StatusBadge.Desc}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
      </Border>

      <TextBlock IsVisible="{Binding ShowBadges}" Text="StatusBadge" FontWeight="Bold" />
      <WrapPanel IsVisible="{Binding ShowBadges}">
        <codewf:StatusBadge Classes="Debug" LeftText="Debug" RightText="{codewf:I18n Demo.Text.StatusComponentsPage.View002}" Margin="0,0,8,8" />
        <codewf:StatusBadge Classes="Info" LeftText="Info" RightText="{codewf:I18n Demo.Text.StatusComponentsPage.View003}" Margin="0,0,8,8" />
        <codewf:StatusBadge Classes="Warn" LeftText="Warn" RightText="{codewf:I18n Demo.Text.StatusComponentsPage.View004}" Margin="0,0,8,8" />
        <codewf:StatusBadge Classes="Error" LeftText="Error" RightText="{codewf:I18n Demo.Text.StatusComponentsPage.View005}" Margin="0,0,8,8" />
        <codewf:StatusBadge Classes="Fatal" LeftText="Fatal" RightText="{codewf:I18n Demo.Text.StatusComponentsPage.View006}" Margin="0,0,8,8" />
      </WrapPanel>

      <TextBlock IsVisible="{Binding ShowCards}" Text="StatusCard" FontWeight="Bold" />
      <WrapPanel IsVisible="{Binding ShowCards}">
        <codewf:StatusCard Width="180" Height="80" Kind="Debug" TopText="DEBUG" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View007}" Margin="0,0,8,8" />
        <codewf:StatusCard Width="180" Height="80" Kind="Info" TopText="INFO" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View008}" Margin="0,0,8,8" />
        <codewf:StatusCard Width="180" Height="80" Kind="Warn" TopText="WARN" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View009}" Margin="0,0,8,8" />
        <codewf:StatusCard Width="180" Height="80" Kind="Error" TopText="ERROR" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View010}" Margin="0,0,8,8" />
        <codewf:StatusCard Width="180" Height="80" Kind="Fatal" TopText="FATAL" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View011}" Margin="0,0,8,8" />
      </WrapPanel>

      <TextBlock Text="{codewf:I18n Demo.Text.StatusComponentsPage.View012}" FontWeight="Bold" />
      <codewf:StatusBadge IsVisible="{Binding ShowBadges}" LeftText="{Binding BadgeKind}" RightText="{Binding BadgeText}"
                          Classes.Debug="{Binding BadgeDebug}" Classes.Info="{Binding BadgeInfo}" Classes.Warn="{Binding BadgeWarn}"
                          Classes.Error="{Binding BadgeError}" Classes.Fatal="{Binding BadgeFatal}" HorizontalAlignment="Left" />
      <codewf:StatusCard IsVisible="{Binding ShowCards}" x:Name="DrivenCard" Kind="{Binding Kind}"
                         TopText="DRIVEN" BottomText="{codewf:I18n Demo.Text.StatusComponentsPage.View013}" IconWidth="{Binding IconWidth}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
