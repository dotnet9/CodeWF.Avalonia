<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.DataGridPage"
             x:DataType="vm:DataGridPageViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="Auto,Auto,*,Auto,*" Margin="12,10">

    <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <TextBlock Text="{codewf:I18n Demo.Text.DataGridPage.View001}"
                 TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
    </Border>

    <TextBlock Grid.Row="1" Text="{codewf:I18n Demo.Text.DataGridPage.View002}" FontWeight="SemiBold" Margin="0,10,0,4" />

    <DataGrid Grid.Row="2" x:Name="EnhancedGrid" RowHeight="{Binding RowHeight}"
              codewf:DataGridEnhancement.UseDefaults="{Binding UseDefaults}"
              ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False" CanUserSortColumns="True"
              IsReadOnly="True" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" BorderThickness="1">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{codewf:I18n Demo.Text.DataGridPage.View003}" Binding="{Binding Name}" Width="140" />
        <DataGridTextColumn Header="{codewf:I18n Demo.Text.DataGridPage.View004}" Binding="{Binding Age}" Width="90" />
        <DataGridTextColumn Header="{codewf:I18n Demo.Text.DataGridPage.View005}" Binding="{Binding City}" Width="140" />
        <DataGridTextColumn Header="{codewf:I18n Demo.Text.DataGridPage.View006}" Binding="{Binding Comment}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="3" Text="{codewf:I18n Demo.Text.DataGridPage.View007}" FontWeight="SemiBold" Margin="0,10,0,4" />

    <DataGrid Grid.Row="4"
              ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False" CanUserSortColumns="True"
              IsReadOnly="True" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" BorderThickness="1">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{codewf:I18n Demo.Text.DataGridPage.View008}" Binding="{Binding Name}" Width="140" />
        <DataGridTextColumn Header="{codewf:I18n Demo.Text.DataGridPage.View009}" Binding="{Binding Age}" Width="90" />
        <DataGridTextColumn Header="{codewf:I18n Demo.Text.DataGridPage.View010}" Binding="{Binding City}" Width="140" />
        <DataGridTextColumn Header="{codewf:I18n Demo.Text.DataGridPage.View011}" Binding="{Binding Comment}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
