<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.TrapezoidTabPage"
             x:CompileBindings="False">
  <StackPanel Margin="12,10" Spacing="14">

    <Border Padding="10" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <TextBlock Text="{codewf:I18n Demo.Content.TrapezoidTab.View.TrapezoidControlThemeAdaptsTheFirstMiddleAndFinal}"
                 TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
    </Border>

    <TextBlock Text="{codewf:I18n Demo.Content.TrapezoidTab.View.TabControlTrapezoidTheme}" FontWeight="Bold" />
    <TabControl Theme="{StaticResource TrapezoidShapedTabControl}" Height="180">
      <TabItem Header="{codewf:I18n Demo.Content.TrapezoidTab.View.Home}">
        <Border Padding="12"><TextBlock Text="{codewf:I18n Demo.Content.TrapezoidTab.View.FirstTabFlushLeftEdgeAndSlantedRight}" /></Border>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Content.TrapezoidTab.View.Design}">
        <Border Padding="12"><TextBlock Text="{codewf:I18n Demo.Content.TrapezoidTab.View.MiddleTabTwoSlantedEdgesDiagonalFilletRatioSetsThe}" /></Border>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Content.TrapezoidTab.View.Development}">
        <Border Padding="12"><TextBlock Text="{codewf:I18n Demo.Content.TrapezoidTab.View.MiddleTabHighlightedOutlineWhenSelected}" /></Border>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Content.TrapezoidTab.View.Release}">
        <Border Padding="12"><TextBlock Text="{codewf:I18n Demo.Content.TrapezoidTab.View.MiddleTabHoverAndPressedFeedback}" /></Border>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Content.TrapezoidTab.View.About}">
        <Border Padding="12"><TextBlock Text="{codewf:I18n Demo.Content.TrapezoidTab.View.LastTabFlushRightEdgeAndSlantedLeft}" /></Border>
      </TabItem>
    </TabControl>

    <TextBlock Text="{codewf:I18n Demo.Content.TrapezoidTab.View.TabStripStandalone}" FontWeight="Bold" />
    <TabStrip Theme="{StaticResource TrapezoidShapedTabStrip}" SelectedIndex="1">
      <TabStripItem Content="{codewf:I18n Demo.Content.TrapezoidTab.View.Overview}" Padding="16,6" />
      <TabStripItem Content="{codewf:I18n Demo.Content.TrapezoidTab.View.Details}" Padding="16,6" />
      <TabStripItem Content="{codewf:I18n Demo.Content.TrapezoidTab.View.Statistics}" Padding="16,6" />
    </TabStrip>
    <Panel Height="72">
      <TextBlock Text="{codewf:I18n Demo.Content.TrapezoidTab.View.TabStripManagesSelectionTheHostSuppliesTheAssociated}"
                 Opacity="0.7" FontSize="12" />
    </Panel>
  </StackPanel>
</UserControl>
