<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.TrapezoidTabPage"
             x:CompileBindings="False">
  <StackPanel Margin="12,10" Spacing="14">

    <Border Padding="10" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <TextBlock Text="{codewf:I18n Demo.Text.TrapezoidTabPage.View001}"
                 TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
    </Border>

    <TextBlock Text="{codewf:I18n Demo.Text.TrapezoidTabPage.View002}" FontWeight="Bold" />
    <TabControl Theme="{StaticResource TrapezoidShapedTabControl}" Height="180">
      <TabItem Header="{codewf:I18n Demo.Text.TrapezoidTabPage.View003}">
        <Border Padding="12"><TextBlock Text="{codewf:I18n Demo.Text.TrapezoidTabPage.View004}" /></Border>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Text.TrapezoidTabPage.View005}">
        <Border Padding="12"><TextBlock Text="{codewf:I18n Demo.Text.TrapezoidTabPage.View006}" /></Border>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Text.TrapezoidTabPage.View007}">
        <Border Padding="12"><TextBlock Text="{codewf:I18n Demo.Text.TrapezoidTabPage.View008}" /></Border>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Text.TrapezoidTabPage.View009}">
        <Border Padding="12"><TextBlock Text="{codewf:I18n Demo.Text.TrapezoidTabPage.View010}" /></Border>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Text.TrapezoidTabPage.View011}">
        <Border Padding="12"><TextBlock Text="{codewf:I18n Demo.Text.TrapezoidTabPage.View012}" /></Border>
      </TabItem>
    </TabControl>

    <TextBlock Text="{codewf:I18n Demo.Text.TrapezoidTabPage.View013}" FontWeight="Bold" />
    <TabStrip Theme="{StaticResource TrapezoidShapedTabStrip}" SelectedIndex="1">
      <TabStripItem Content="{codewf:I18n Demo.Text.TrapezoidTabPage.View014}" Padding="16,6" />
      <TabStripItem Content="{codewf:I18n Demo.Text.TrapezoidTabPage.View015}" Padding="16,6" />
      <TabStripItem Content="{codewf:I18n Demo.Text.TrapezoidTabPage.View016}" Padding="16,6" />
    </TabStrip>
    <Panel Height="72">
      <TextBlock Text="{codewf:I18n Demo.Text.TrapezoidTabPage.View017}"
                 Opacity="0.7" FontSize="12" />
    </Panel>
  </StackPanel>
</UserControl>
