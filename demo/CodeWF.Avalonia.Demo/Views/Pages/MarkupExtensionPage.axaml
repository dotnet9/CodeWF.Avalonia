<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.MarkupExtensionPage"
             x:DataType="vm:MarkupExtensionPageViewModel"
             x:CompileBindings="True">
  <StackPanel Margin="12,10" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

    <Border IsVisible="{Binding ShowIf}" Padding="14" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <StackPanel Spacing="10">
        <TextBlock Text="{codewf:I18n Demo.Markup.IfTitle}" FontWeight="Bold" />
        <ToggleSwitch IsChecked="{Binding IsBusy}"
                      OnContent="IsBusy = true"
                      OffContent="IsBusy = false" />
        <TextBlock FontSize="15">
          <TextBlock.Text>
            <codewf:If Condition="{Binding IsBusy}" True="{codewf:I18n Demo.Content.MarkupExtension.View.TaskRunningPleaseWait}" False="{codewf:I18n Demo.Content.MarkupExtension.View.SystemIdle}" />
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding ShowSwitch}" Padding="14" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <StackPanel Spacing="10">
        <TextBlock Text="{codewf:I18n Demo.Markup.SwitchTitle}" FontWeight="Bold" />
        <ComboBox MinWidth="160" ItemsSource="{Binding StateOptions}" SelectedItem="{Binding State}" />
        <TextBlock FontSize="15">
          <TextBlock.Text>
            <codewf:Switch Value="{Binding State}" Default="{codewf:I18n Demo.Content.MarkupExtension.View.UnknownState}">
              <codewf:SwitchCase When="{codewf:I18n Demo.Content.MarkupExtension.View.Running}" Then="{codewf:I18n Demo.Content.MarkupExtension.View.ServiceRunning}" />
              <codewf:SwitchCase When="{codewf:I18n Demo.Content.MarkupExtension.View.Paused}" Then="{codewf:I18n Demo.Content.MarkupExtension.View.ServicePaused}" />
              <codewf:SwitchCase When="{codewf:I18n Demo.Content.MarkupExtension.View.Maintenance}" Then="{codewf:I18n Demo.Content.MarkupExtension.View.MaintenanceWindowOpen}" />
            </codewf:Switch>
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
