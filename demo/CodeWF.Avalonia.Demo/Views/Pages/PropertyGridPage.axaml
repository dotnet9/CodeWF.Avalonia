<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.PropertyGridPage"
             x:DataType="vm:PropertyPanelDemoViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="Auto,*" Margin="12,10">

    <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="{codewf:I18n Demo.Content.PropertyGrid.View.PropertyGridDisplaysACompleteValvePropertyTreeTry}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.PropertyGrid.View.ExpandAll}" Click="OnExpandAll" />
          <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.PropertyGrid.View.CollapseAll}" Click="OnCollapseAll" />
          <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.PropertyGrid.View.ResetAllChanges}" Click="OnResetAll" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="2*,*" Margin="0,10,0,0">
      <codewf:PropertyGrid Grid.Column="0" x:Name="DemoGrid"
                           Items="{Binding Items}"
                           ViewMode="{Binding ViewMode}"
                           ShowToolBar="{Binding ShowToolBar}"
                           ShowDescriptionPane="{Binding ShowDescriptionPane}"
                           SearchText="{Binding SearchText}"
                           NameColumnWidth="{Binding NameColumnWidth}"
                           ValueCommittedCommand="{Binding ValueCommittedCommand}"
                           BrowseRequestedCommand="{Binding BrowseRequestedCommand}" />

      <Border Grid.Column="1" BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
              BorderThickness="1,0,0,0" Padding="10,0,0,0">
        <Grid RowDefinitions="Auto,*,Auto,*">
          <TextBlock Grid.Row="0" Text="{codewf:I18n Demo.Content.PropertyGrid.View.ValueChanges}" FontWeight="Bold" Margin="0,0,0,4" />
          <ListBox Grid.Row="1" ItemsSource="{Binding ChangeLog}" FontSize="11" />
          <TextBlock Grid.Row="2" Text="{codewf:I18n Demo.Content.PropertyGrid.View.BrowseRequests}" FontWeight="Bold" Margin="0,8,0,4" />
          <ListBox Grid.Row="3" ItemsSource="{Binding BrowseLog}" FontSize="11" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
