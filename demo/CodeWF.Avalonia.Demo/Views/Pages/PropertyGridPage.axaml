<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.PropertyGridPage"
             x:DataType="vm:PropertyPanelDemoViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="Auto,*" Margin="12,10">

    <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="PropertyGrid 自我演示：右侧属性面板即本控件；此处再放一个实例承载完整的阀门属性树。试试：搜索过滤、分类/字母视图、修改值出现加粗与子树重置、右键行重置单项、拖拽名称列宽。"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="全部展开" Click="OnExpandAll" />
          <Button Content="全部折叠" Click="OnCollapseAll" />
          <Button Content="重置全部修改" Click="OnResetAll" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="2*,*" Margin="0,10,0,0">
      <codewf:PropertyGrid Grid.Column="0" x:Name="DemoGrid"
                           Items="{Binding Items}"
                           ViewMode="{Binding ViewMode}"
                           ShowToolBar="{Binding ShowToolBar}"
                           ShowDescriptionPane="{Binding ShowDescriptionPane}"
                           SearchText="{Binding SearchText}"
                           NameColumnWidth="{Binding NameColumnWidth}"
                           ValueCommittedCommand="{Binding ValueCommittedCommand}"
                           BrowseRequestedCommand="{Binding BrowseRequestedCommand}" />

      <Border Grid.Column="1" BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
              BorderThickness="1,0,0,0" Padding="10,0,0,0">
        <Grid RowDefinitions="Auto,*,Auto,*">
          <TextBlock Grid.Row="0" Text="值变更日志" FontWeight="Bold" Margin="0,0,0,4" />
          <ListBox Grid.Row="1" ItemsSource="{Binding ChangeLog}" FontSize="11" />
          <TextBlock Grid.Row="2" Text="浏览请求" FontWeight="Bold" Margin="0,8,0,4" />
          <ListBox Grid.Row="3" ItemsSource="{Binding BrowseLog}" FontSize="11" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
