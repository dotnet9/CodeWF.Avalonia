<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com" xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.LogPage"
             x:DataType="vm:LogPageViewModel" x:CompileBindings="True">
  <Grid RowDefinitions="Auto,Auto,*" Margin="12,10">

    <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
      <TextBlock Text="{codewf:I18n Demo.Text.LogPage.View001}"
                 TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
      <Button Content="Trace" Command="{Binding WriteCommand}" CommandParameter="Trace" />
      <Button Content="Debug" Command="{Binding WriteCommand}" CommandParameter="Debug" />
      <Button Content="Info" Command="{Binding WriteCommand}" CommandParameter="Info" />
      <Button Content="Warning" Command="{Binding WriteCommand}" CommandParameter="Warning" />
      <Button Content="Error" Command="{Binding WriteCommand}" CommandParameter="Error" />
      <Button Content="Critical" Command="{Binding WriteCommand}" CommandParameter="Critical" />
      <Button Content="{codewf:I18n Demo.Text.LogPage.View002}" Command="{Binding BurstCommand}" />
    </StackPanel>

    <codewf:LogView Grid.Row="2" x:Name="LogViewControl" Margin="0,8,0,0" MaxDisplayCount="{Binding MaxDisplayCount}" MinimumLevel="{Binding MinimumLevel}" />
  </Grid>
</UserControl>
