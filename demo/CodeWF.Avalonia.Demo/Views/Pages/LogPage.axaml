<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com" xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels.Pages"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.LogPage"
             x:DataType="vm:LogPageViewModel" x:CompileBindings="True">
  <Grid RowDefinitions="Auto,Auto,*" Margin="12,10">

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
      <Button Classes="demo-action" Content="Trace" Command="{Binding WriteCommand}" CommandParameter="Trace" />
      <Button Classes="demo-action" Content="Debug" Command="{Binding WriteCommand}" CommandParameter="Debug" />
      <Button Classes="demo-action" Content="Info" Command="{Binding WriteCommand}" CommandParameter="Info" />
      <Button Classes="demo-action" Content="Warning" Command="{Binding WriteCommand}" CommandParameter="Warning" />
      <Button Classes="demo-action" Content="Error" Command="{Binding WriteCommand}" CommandParameter="Error" />
      <Button Classes="demo-action" Content="Critical" Command="{Binding WriteCommand}" CommandParameter="Critical" />
      <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.Log.View.WriteBatchEventStreamLoadTest}" Command="{Binding BurstCommand}" />
    </StackPanel>

    <codewf:LogView Grid.Row="2" x:Name="LogViewControl" Margin="0,8,0,0" MaxDisplayCount="{Binding MaxDisplayCount}" MinimumLevel="{Binding MinimumLevel}" />
  </Grid>
</UserControl>
