<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.CodeWFWindowPage"
             x:CompileBindings="False">
  <ScrollViewer>
    <StackPanel Margin="12,10" Spacing="12">

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="OpenWindowButton" Classes="demo-action" Content="{codewf:I18n Demo.Content.CodeWFWindow.View.OpenDefaultConfiguration}" Click="OnOpenDefault" />
        <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.CodeWFWindow.View.OpenMinimalButtonsAndCustomTitleBar}" Click="OnOpenCustom" />
        <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.CodeWFWindow.View.OpenExtendContentIntoTitleBar}" Click="OnOpenExtends" />
      </StackPanel>

      <WrapPanel>
        <Border Width="380" Margin="0,0,12,12" Padding="12" CornerRadius="8"
                BorderThickness="1" BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="{codewf:I18n Demo.Content.CodeWFWindow.View.Example1DefaultTitleBar}" FontSize="12" Opacity="0.7" />
            <Border BorderThickness="1" CornerRadius="6"
                    BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
              <codewf:CodeWFTitleBar Title="{codewf:I18n Demo.Content.CodeWFWindow.View.BorderlessCustomTitleBar}" Height="36" />
            </Border>
            <TextBlock Text="{codewf:I18n Demo.Content.CodeWFWindow.View.TitleBarHeight36WithMinimizeRestoreCloseButtons}" FontSize="11" Opacity="0.6" />
          </StackPanel>
        </Border>

        <Border Width="380" Margin="0,0,12,12" Padding="12" CornerRadius="8"
                BorderThickness="1" BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="{codewf:I18n Demo.Content.CodeWFWindow.View.Example2CustomLeftRightContent}" FontSize="12" Opacity="0.7" />
            <Border BorderThickness="1" CornerRadius="6"
                    BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
              <codewf:CodeWFTitleBar Title="{codewf:I18n Demo.Content.CodeWFWindow.View.DocumentDesignNotes}" Height="36">
                <codewf:CodeWFTitleBar.LeftContent>
                  <TextBlock Text="◆" Foreground="{DynamicResource StudioAccent}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </codewf:CodeWFTitleBar.LeftContent>
                <codewf:CodeWFTitleBar.RightContent>
                  <TextBox Width="140" Height="24" PlaceholderText="{codewf:I18n Demo.Content.CodeWFWindow.View.Search}" VerticalAlignment="Center" Margin="0,0,10,0" />
                </codewf:CodeWFTitleBar.RightContent>
              </codewf:CodeWFTitleBar>
            </Border>
            <TextBlock Text="{codewf:I18n Demo.Content.CodeWFWindow.View.LeftContentRightContentAcceptArbitraryContent}" FontSize="11" Opacity="0.6" />
          </StackPanel>
        </Border>

        <Border Width="380" Padding="12" CornerRadius="8"
                BorderThickness="1" BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="{codewf:I18n Demo.Content.CodeWFWindow.View.Example3CenteredContent}" FontSize="12" Opacity="0.7" />
            <Border BorderThickness="1" CornerRadius="6"
                    BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
              <codewf:CodeWFTitleBar Title="{codewf:I18n Demo.Content.CodeWFWindow.View.Left}" Height="36">
                <codewf:CodeWFTitleBar.CenterContent>
                  <TextBlock Text="{codewf:I18n Demo.Content.CodeWFWindow.View.CenteredTitleCenterContent}" Opacity="0.8" VerticalAlignment="Center" FontSize="12" />
                </codewf:CodeWFTitleBar.CenterContent>
              </codewf:CodeWFTitleBar>
            </Border>
            <TextBlock Text="{codewf:I18n Demo.Content.CodeWFWindow.View.ArrangeCenterContentAndTheTitleToAvoidOverlap}" FontSize="11" Opacity="0.6" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
