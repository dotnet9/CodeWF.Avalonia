<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.GuidePage"
             x:CompileBindings="False">
  <Panel>
    <Grid RowDefinitions="Auto,*" Margin="12,10">

      <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.Guide.View.StartGuide13Placements}" Click="OnStartGuide" />
          <TextBlock Text="{codewf:I18n Demo.Content.Guide.View.HighlightTheTargetIn13PlacementsWithEnter}"
                     TextWrapping="Wrap" Opacity="0.75" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <UniformGrid Grid.Row="1" Rows="3" Columns="3" Margin="24">
        <Button Classes="demo-action" x:Name="TargetCenter" Content="Center" Height="64" Margin="8" />
        <Button Classes="demo-action" x:Name="TargetTopLeft" Content="TopLeft" Height="64" Margin="8" />
        <Button Classes="demo-action" x:Name="TargetTopRight" Content="TopRight" Height="64" Margin="8" />
        <Button Classes="demo-action" x:Name="TargetLeft" Content="Left" Height="64" Margin="8" />
        <Button Classes="demo-action" x:Name="TargetTop" Content="Top" Height="64" Margin="8" />
        <Button Classes="demo-action" x:Name="TargetRight" Content="Right" Height="64" Margin="8" />
        <Button Classes="demo-action" x:Name="TargetBottomLeft" Content="BottomLeft" Height="64" Margin="8" />
        <Button Classes="demo-action" x:Name="TargetBottom" Content="Bottom" Height="64" Margin="8" />
        <Button Classes="demo-action" x:Name="TargetBottomRight" Content="BottomRight" Height="64" Margin="8" />
      </UniformGrid>
    </Grid>

    <!--  引导步骤：目标用元素名绑定；步骤切换 / 完成事件在代码中记录  -->
    <codewf:Guide x:Name="Guide" IsArrowVisible="True" Completed="OnGuideCompleted">
      <codewf:GuideStep Title="{codewf:I18n Demo.Content.Guide.View.Step1Center}"
                        Description="{codewf:I18n Demo.Content.Guide.View.IsPointAtCenterTrueOrNoTargetHighlightsTheScreen}"
                        Target="{Binding #TargetCenter}"
                        Placement="Center" IsPointAtCenter="True" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Content.Guide.View.Step2TopLeft}"
                        Description="{codewf:I18n Demo.Content.Guide.View.TheBubbleAppearsAtTheUpperLeftOf}"
                        Target="{Binding #TargetTopLeft}"
                        Placement="TopLeft" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Content.Guide.View.Step3TopRight}"
                        Description="{codewf:I18n Demo.Content.Guide.View.TheBubbleAppearsAtTheUpperRightOf}"
                        Target="{Binding #TargetTopRight}"
                        Placement="TopRight" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Content.Guide.View.Step4Right}"
                        Description="{codewf:I18n Demo.Content.Guide.View.TheBubbleAppearsToTheRightOfThe}"
                        Target="{Binding #TargetRight}"
                        Placement="Right" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Content.Guide.View.Step5Bottom}"
                        Description="{codewf:I18n Demo.Content.Guide.View.TheBubbleAppearsBelowTheTarget}"
                        Target="{Binding #TargetBottom}"
                        Placement="Bottom" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Content.Guide.View.Step6LeftBottom}"
                        Description="{codewf:I18n Demo.Content.Guide.View.TheBubbleAppearsAtTheLowerLeftWith}"
                        Target="{Binding #TargetBottomLeft}"
                        Placement="LeftBottom" StyleType="Primary" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Content.Guide.View.Step7CustomMaskColor}"
                        Description="{codewf:I18n Demo.Content.Guide.View.ThisStepDemonstratesATranslucentRedMaskColor}"
                        Target="{Binding #TargetTop}"
                        Placement="Top" MaskColor="#66B3261E" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Content.Guide.View.Step8Complete}"
                        Description="{codewf:I18n Demo.Content.Guide.View.FinalStepPressEnterOrClickFinishTo}"
                        Target="{Binding #TargetBottomRight}"
                        Placement="BottomRight" />
    </codewf:Guide>
  </Panel>
</UserControl>
