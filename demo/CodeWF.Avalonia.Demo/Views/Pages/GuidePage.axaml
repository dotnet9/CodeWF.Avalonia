<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.GuidePage"
             x:CompileBindings="False">
  <Panel>
    <Grid RowDefinitions="Auto,*" Margin="12,10">

      <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{codewf:I18n Demo.Text.GuidePage.View001}" Click="OnStartGuide" />
          <TextBlock Text="{codewf:I18n Demo.Text.GuidePage.View002}"
                     TextWrapping="Wrap" Opacity="0.75" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <UniformGrid Grid.Row="1" Rows="3" Columns="3" Margin="24">
        <Button x:Name="TargetCenter" Content="Center" Height="64" Margin="8" />
        <Button x:Name="TargetTopLeft" Content="TopLeft" Height="64" Margin="8" />
        <Button x:Name="TargetTopRight" Content="TopRight" Height="64" Margin="8" />
        <Button x:Name="TargetLeft" Content="Left" Height="64" Margin="8" />
        <Button x:Name="TargetTop" Content="Top" Height="64" Margin="8" />
        <Button x:Name="TargetRight" Content="Right" Height="64" Margin="8" />
        <Button x:Name="TargetBottomLeft" Content="BottomLeft" Height="64" Margin="8" />
        <Button x:Name="TargetBottom" Content="Bottom" Height="64" Margin="8" />
        <Button x:Name="TargetBottomRight" Content="BottomRight" Height="64" Margin="8" />
      </UniformGrid>
    </Grid>

    <!--  引导步骤：目标用元素名绑定；步骤切换 / 完成事件在代码中记录  -->
    <codewf:Guide x:Name="Guide" IsArrowVisible="True" Completed="OnGuideCompleted">
      <codewf:GuideStep Title="{codewf:I18n Demo.Text.GuidePage.View003}"
                        Description="{codewf:I18n Demo.Text.GuidePage.View004}"
                        Target="{Binding #TargetCenter}"
                        Placement="Center" IsPointAtCenter="True" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Text.GuidePage.View005}"
                        Description="{codewf:I18n Demo.Text.GuidePage.View006}"
                        Target="{Binding #TargetTopLeft}"
                        Placement="TopLeft" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Text.GuidePage.View007}"
                        Description="{codewf:I18n Demo.Text.GuidePage.View008}"
                        Target="{Binding #TargetTopRight}"
                        Placement="TopRight" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Text.GuidePage.View009}"
                        Description="{codewf:I18n Demo.Text.GuidePage.View010}"
                        Target="{Binding #TargetRight}"
                        Placement="Right" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Text.GuidePage.View011}"
                        Description="{codewf:I18n Demo.Text.GuidePage.View012}"
                        Target="{Binding #TargetBottom}"
                        Placement="Bottom" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Text.GuidePage.View013}"
                        Description="{codewf:I18n Demo.Text.GuidePage.View014}"
                        Target="{Binding #TargetBottomLeft}"
                        Placement="LeftBottom" StyleType="Primary" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Text.GuidePage.View015}"
                        Description="{codewf:I18n Demo.Text.GuidePage.View016}"
                        Target="{Binding #TargetTop}"
                        Placement="Top" MaskColor="#66B3261E" />
      <codewf:GuideStep Title="{codewf:I18n Demo.Text.GuidePage.View017}"
                        Description="{codewf:I18n Demo.Text.GuidePage.View018}"
                        Target="{Binding #TargetBottomRight}"
                        Placement="BottomRight" />
    </codewf:Guide>
  </Panel>
</UserControl>
