<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             x:Class="CodeWF.Avalonia.Demo.Views.Pages.AppGuidePage"
             x:CompileBindings="False">
  <Panel>
    <StackPanel Margin="12,10" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">

      <Border Padding="10" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}">
        <TextBlock Text="{codewf:I18n Demo.Content.AppGuide.View.TourTheRibbonNavigationDocumentsPropertiesAndLogs}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
      </Border>

      <Button Classes="demo-action" Content="{codewf:I18n Demo.Content.AppGuide.View.StartWorkspaceTour}" Click="OnStartGuide" HorizontalAlignment="Left" />

      <TextBlock Text="{codewf:I18n Demo.Content.AppGuide.View.TourRegions}" FontWeight="Bold" />
      <TextBlock Text="{codewf:I18n Demo.Content.AppGuide.View.RibbonCommandsNavigationDocumentsWithDemoXAMLC}"
                 TextWrapping="Wrap" Opacity="0.8" LineHeight="22" />
    </StackPanel>

    <codewf:Guide x:Name="AppGuide" IsArrowVisible="True" />
  </Panel>
</UserControl>
