<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:codewf="https://codewf.com" xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels"
 x:Class="CodeWF.Avalonia.Demo.Views.DemoDocumentView" x:DataType="vm:DemoDocumentViewModel" x:CompileBindings="True">
 <Grid x:Name="DocumentWorkspace" Background="{DynamicResource StudioBackground}">
  <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
  <Border Padding="16,10" IsVisible="{Binding HasDocumentHeader}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,0,0,1">
   <Grid ColumnDefinitions="*,Auto">
    <StackPanel Spacing="3" Margin="0,0,12,0">
     <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
     <TextBlock Text="{Binding Package}" IsVisible="{Binding HasApi}" Foreground="{DynamicResource StudioAccent}" FontSize="11" />
     <TextBlock Text="{Binding Description}" Foreground="{DynamicResource StudioMuted}" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
    <ToggleButton Grid.Column="1" FontSize="11" Content="{codewf:I18n Demo.Catalog.Source}" IsChecked="{Binding ShowSource}" IsVisible="{Binding HasSource}" VerticalAlignment="Center" />
   </Grid>
  </Border>
   <ContentControl Grid.Row="1" Content="{Binding Page}" />
  <Border Grid.Row="2" IsVisible="{Binding ShowSource}" Height="220" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,1,0,0">
   <Grid RowDefinitions="Auto,*">
    <StackPanel Orientation="Horizontal" Margin="12,4" Spacing="8">
     <RadioButton GroupName="SourceLanguage" Content="XAML" IsChecked="{Binding IsXamlSegment}" IsVisible="{Binding HasXaml}" />
     <RadioButton GroupName="SourceLanguage" Content="C#" IsChecked="{Binding IsCSharpSegment}" IsVisible="{Binding HasCSharp}" />
    </StackPanel>
    <Panel Grid.Row="1"><codewf:MarkdownViewer Markdown="{Binding XamlMarkdown}" IsVisible="{Binding IsXamlSegment}" />
       <codewf:MarkdownViewer Markdown="{Binding CSharpMarkdown}" IsVisible="{Binding IsCSharpSegment}" /></Panel>
   </Grid>
  </Border>
  </Grid>
   <GridSplitter Grid.Column="1" x:Name="DocumentSplitter" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                 HorizontalAlignment="Stretch" Background="{DynamicResource StudioBorder}" IsVisible="{Binding PropertiesVisible}" />
   <Border Grid.Column="2" IsVisible="{Binding PropertiesVisible}" Background="{DynamicResource StudioSurface}">
    <Grid RowDefinitions="Auto,*">
     <TextBlock Text="{codewf:I18n Demo.Tool.Properties}" Margin="12,10" FontSize="12" FontWeight="SemiBold" />
     <codewf:PropertyGrid Grid.Row="1" x:Name="DocumentProperties" NameColumnWidth="118" DefaultRowHeight="31"
                          Items="{Binding PropertyItems}" ValueCommittedCommand="{Binding PropertyValueCommittedCommand}"
                          BrowseRequestedCommand="{Binding PropertyBrowseRequestedCommand}" />
    </Grid>
   </Border>
 </Grid>
</UserControl>
