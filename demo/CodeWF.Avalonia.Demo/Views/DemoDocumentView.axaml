<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Avalonia.Demo.ViewModels"
             x:Class="CodeWF.Avalonia.Demo.Views.DemoDocumentView"
             x:DataType="vm:DemoDocumentViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="Auto,*">

    <!--  文档头部：标题 / 说明 + ShowMeCode 三段切换（同一时刻只显示一段）  -->
    <Border Grid.Row="0" Padding="16,10"
            BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
          <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" />
          <TextBlock Text="{Binding Description}" Opacity="0.72" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Center"
                BorderBrush="{DynamicResource TabControlSeparatorBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="2">
          <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="ShowMeCode"
                         Content="{codewf:I18n Demo.Segment.Demo}"
                         IsChecked="{Binding IsDemoSegment}"
                         Padding="12,4" Background="Transparent" BorderThickness="0" />
            <RadioButton GroupName="ShowMeCode"
                         Content="{codewf:I18n Demo.Segment.Xaml}"
                         IsChecked="{Binding IsXamlSegment}"
                         Padding="12,4" Background="Transparent" BorderThickness="0" />
            <RadioButton GroupName="ShowMeCode"
                         Content="{codewf:I18n Demo.Segment.CSharp}"
                         IsChecked="{Binding IsCSharpSegment}"
                         Padding="12,4" Background="Transparent" BorderThickness="0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!--  文档内容：三段互斥显示  -->
    <Panel Grid.Row="1">
      <ContentControl Content="{Binding Page}" IsVisible="{Binding IsDemoSegment}" />
      <codewf:MarkdownViewer Markdown="{Binding XamlMarkdown}" IsVisible="{Binding IsXamlSegment}" />
      <codewf:MarkdownViewer Markdown="{Binding CSharpMarkdown}" IsVisible="{Binding IsCSharpSegment}" />
    </Panel>
  </Grid>
</UserControl>
