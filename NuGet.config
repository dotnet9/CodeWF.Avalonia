<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <Clear />
    <!--
      artifacts/ 不随仓库提交，CI 检出后并不存在；而 NuGet 对不存在的本地包源目录
      直接报 NU1301，会让整次还原失败（此前该本地源写死在这里，CI 从首次提交起就必然失败）。
      因此这里只注册 nuget.org。本机要用本地打包产物验证时，在命令行临时追加包源即可：
      dotnet restore 的 source 参数先给 artifacts/packages，再给 nuget.org 官方源。
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
