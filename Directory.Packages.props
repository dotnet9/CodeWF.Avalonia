<Project>
  <Import Project="build/Versions.props" />

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia 全家桶 -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="$(AvaloniaControlsDataGridVersion)" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(DotNetLibrariesVersion)" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="$(AvaloniaEditVersion)" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="$(AvaloniaEditTextMateVersion)" />

    <!-- 主题生态 -->
    <PackageVersion Include="Semi.Avalonia" Version="$(SemiAvaloniaVersion)" />

    <PackageVersion Include="Dock.Avalonia.Themes.Simple" Version="$(DockVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.Lang" Version="$(Version)" />
    <PackageVersion Include="TreeDataGrid.Avalonia" Version="$(TreeDataGridAvaloniaVersion)" />
    <PackageVersion Include="Irihi.Ursa" Version="$(UrsaAvaloniaVersion)" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="$(UrsaAvaloniaVersion)" />

    <!-- Dock -->
    <PackageVersion Include="Dock.Avalonia" Version="$(DockVersion)" />
    <PackageVersion Include="Dock.Model.ReactiveUI" Version="$(DockVersion)" />

    <!-- Markdown 能力栈 -->
    <PackageVersion Include="AnimatedImage.Avalonia" Version="$(AnimatedImageAvaloniaVersion)" />
    <PackageVersion Include="Markdig" Version="$(MarkdigVersion)" />
    <PackageVersion Include="Mermaider" Version="$(MermaiderVersion)" />
    <PackageVersion Include="Svg.Controls.Skia.Avalonia" Version="$(SvgControlsSkiaAvaloniaVersion)" />
    <PackageVersion Include="Svg.Skia" Version="$(SvgSkiaVersion)" />
    <PackageVersion Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="HarfBuzzSharp" Version="$(HarfBuzzSharpVersion)" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="$(HarfBuzzSharpVersion)" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.macOS" Version="$(HarfBuzzSharpVersion)" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="$(HarfBuzzSharpVersion)" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Win32" Version="$(HarfBuzzSharpVersion)" />
    <PackageVersion Include="Sylinko.CSharpMath.Avalonia" Version="$(SylinkoCSharpMathAvaloniaVersion)" />
    <PackageVersion Include="TextMateSharp" Version="$(TextMateSharpVersion)" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="$(TextMateSharpGrammarsVersion)" />

    <!-- MVVM / 行为 / DI -->
    <PackageVersion Include="CodeWF.Toolkit.Logging" Version="$(CodeWFToolkitVersion)" />
    <PackageVersion Include="CodeWF.Toolkit.Lang" Version="$(CodeWFToolkitVersion)" />
    <PackageVersion Include="CodeWF.Toolkit.Core" Version="$(CodeWFToolkitVersion)" />
    <!-- Dock.Model.ReactiveUI 12.1.0.13 要求 ReactiveUI 26；保持还原图一致。 -->
    <PackageVersion Include="ReactiveUI" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="$(ReactiveUIAvaloniaVersion)" />
    <PackageVersion Include="Prism.Core" Version="$(PrismCoreVersion)" />
    <PackageVersion Include="Prism.Avalonia" Version="$(PrismAvaloniaVersion)" />
    <PackageVersion Include="Prism.DryIoc.Avalonia" Version="$(PrismAvaloniaVersion)" />
    <PackageVersion Include="DryIoc" Version="$(DryIocVersion)" />
    <PackageVersion Include="Xaml.Behaviors" Version="$(XamlBehaviorsVersion)" />
    <PackageVersion Include="StaticViewLocator" Version="$(StaticViewLocatorVersion)" />

    <!-- 源生成器 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="$(MicrosoftCodeAnalysisAnalyzersVersion)" />
    <!-- 源生成器与 global.json 固定的 .NET 11 编译器一起验证。 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisCSharpVersion)" />
    <PackageVersion Include="System.Text.Json" Version="$(DotNetLibrariesVersion)" />

    <!-- 平台补充 -->
    <PackageVersion Include="System.Drawing.Common" Version="$(DotNetLibrariesVersion)" />
    <PackageVersion Include="System.Security.Permissions" Version="$(DotNetLibrariesVersion)" />
    <PackageVersion Include="System.Windows.Extensions" Version="$(DotNetLibrariesVersion)" />

    <!-- 打包基础设施 -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="$(MicrosoftSourceLinkGitHubVersion)" />

    <!-- 测试 -->
    <PackageVersion Include="coverlet.collector" Version="$(CoverletCollectorVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNetTestSdkVersion)" />
    <PackageVersion Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)" />
    <PackageVersion Include="Bogus" Version="$(BogusVersion)" />
  </ItemGroup>
</Project>
